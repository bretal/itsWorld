# ItsWorld 开发环境 - 环境变量配置模板
#
# ⚠️  此文件是模板，应提交到 Git
#
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 在 .env 中填入实际的 API 密钥
#   3. 不要提交 .env 文件到 Git（已在 .gitignore 中）

# ========================================
# AI/LLM 服务 API 密钥
# ========================================

# 阿里云 DashScope (通义千问)
# 用途: 日记内容生成、语义理解、养护建议
# 获取地址: https://dashscope.console.aliyun.com
# 步骤:
#   1. 注册/登录阿里云账号
#   2. 开通 DashScope 服务
#   3. 创建 API Key
#   4. 复制 Key 粘贴到下方
AI_DASHSCOPE_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API
# 用途: 备选大模型，可用于对比测试
# 获取地址: https://platform.deepseek.com
AI_DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# 计算机视觉 API - 宠物情绪识别
# 提供商选项: baidu / aliyun / azure / custom
#
# Baidu 人脸识别 API (推荐用于动物识别):
#   - 获取地址: https://console.bce.baidu.com
#   - 创建应用后获得 API Key
AI_VISION_KEY=your-vision-api-key-here
AI_VISION_PROVIDER=baidu

# ========================================
# 可选：第三方服务配置（后续功能）
# ========================================

# 微信小程序登录配置
# WECHAT_MINI_PROGRAM_APPID=
# WECHAT_MINI_PROGRAM_SECRET=

# 邮件服务（消息通知）
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# 短信服务（验证码）
# SMS_PROVIDER=aliyun  # or tencent, baidu
# SMS_ACCESS_KEY=
# SMS_SECRET_KEY=
