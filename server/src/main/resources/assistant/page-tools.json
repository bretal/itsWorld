[
  {"type":"function","function":{"name":"navigate","description":"打开健康页或日记编辑页，等待加载完成。","parameters":{"type":"object","properties":{"page":{"type":"string","enum":["health","diary"]}},"required":["page"],"additionalProperties":false}}},
