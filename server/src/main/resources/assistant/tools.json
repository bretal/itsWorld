[
  {
    "type": "function",
    "function": {
      "name": "search_products",
      "description": "按关键词与普通售价预算搜索真实在售有货商品",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 60
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "allowCategoryFallback": {
            "type": "boolean",
            "description": "关键词无可推荐结果时，允许保留分类和预算并查找同类替代品。硬性要求无法核验时设为 false。"
          },
          "maxPriceYuan": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_product",
      "description": "查询真实商品当前有货规格，空结果表示不可推荐",
      "parameters": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "required": [
          "productId"
        ],
        "additionalProperties": false
      }
    }
  }
]
