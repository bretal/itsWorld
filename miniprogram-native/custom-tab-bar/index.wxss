.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff9f5;
  box-shadow: 0 -10rpx 30rpx rgba(160, 110, 70, 0.08);
}

.tabbar-inner {
  position: relative;
  display: flex;
  align-items: flex-end;
  height: 128rpx;
  padding: 0 8rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 16rpx;
}

.tab-icon {
  width: 76rpx;
  height: 76rpx;
  transition: opacity 0.2s ease;
}

.tab-icon.dim {
  opacity: 0.75;
}

.tab-text {
  margin-top: 2rpx;
  color: #7d6a5d;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: #f5a623;
  font-weight: 700;
}

.tab-center {
  position: relative;
  flex: 1;
  height: 100%;
}

.publish-button {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 150rpx;
  height: 150rpx;
  margin-left: -75rpx;
  border-radius: 50%;
  box-shadow: 0 14rpx 28rpx rgba(245, 150, 60, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-image {
  width: 150rpx;
  height: 150rpx;
}
