.onboarding {
  box-sizing: border-box;
  min-height: 100vh;
  min-height: 100dvh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(150deg, #fff3df, #f7e8ce);
  color: #233f27;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  justify-content: flex-end;
}

.skip {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 0 12rpx;
  font-size: 28rpx;
}

.swiper {
  flex: none;
  height: calc(45vh + 204rpx);
}

.slide {
  text-align: center;
}

.illustration {
  display: block;
  width: 100%;
  height: 45vh;
  border-radius: 20rpx;
}

.slide-title,
.slide-desc {
  white-space: pre-line;
  font-family: 'Songti SC', SimSun, serif;
}

.slide-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.22;
}

.slide-desc {
  margin-top: 10rpx;
  color: #486047;
  font-size: 26rpx;
  line-height: 1.5;
}

.bottom {
  margin-top: auto;
}

.dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 99rpx;
  background: #c6b994;
}

.dot.active {
  width: 24rpx;
  background: #ae5436;
}

.next {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 44px;
  border-radius: 999rpx;
  background: #233f27;
  color: #fffaf0;
  font-size: 32rpx;
  font-weight: 700;
}

.next::after {
  border: 0;
}
