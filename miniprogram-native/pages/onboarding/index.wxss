.onboarding {
  min-height: 100vh;
  padding: calc(40rpx + env(safe-area-inset-top)) 48rpx
    calc(48rpx + env(safe-area-inset-bottom));
  background: #fffdf8;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

.step {
  font-size: 24rpx;
  color: #8a8f99;
  letter-spacing: 2rpx;
}

.skip {
  font-size: 26rpx;
  color: #8a8f99;
  padding: 8rpx 4rpx;
}

.swiper {
  flex: 1;
  margin-top: 20rpx;
}

.slide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16rpx;
}

.illustration {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
}

.blob-a {
  width: 240rpx;
  height: 240rpx;
  top: -60rpx;
  right: -40rpx;
}

.blob-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -40rpx;
  left: -30rpx;
}

.emoji {
  position: relative;
  z-index: 2;
  font-size: 220rpx;
  line-height: 1;
}

.slide-title {
  margin-top: 64rpx;
  font-size: 52rpx;
  line-height: 1.35;
  font-weight: 800;
  text-align: center;
  color: #1f2329;
  white-space: pre-line;
}

.slide-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  text-align: center;
  color: #8a8f99;
  white-space: pre-line;
}

.bottom {
  padding-top: 32rpx;
}

.dots {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e3e5e8;
  margin: 0 8rpx;
}

.dot.active {
  width: 32rpx;
  border-radius: 6rpx;
  background: #2f80ed;
}

.next {
  width: 100%;
}
