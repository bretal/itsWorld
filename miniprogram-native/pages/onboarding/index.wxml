<view class="onboarding" style="padding-top: {{topInset}}px">
  <view class="topbar">
    <view class="skip" bindtap="onSkip">跳过</view>
  </view>

  <swiper
    class="swiper"
    current="{{current}}"
    bindchange="onSwiperChange"
    duration="300"
  >
    <swiper-item wx:for="{{slides}}" wx:key="title">
      <view class="slide">
        <image wx:if="{{index <= lastImageIndex}}" class="illustration"
          src="{{item.image}}" mode="aspectFit" bindload="onFirstImageReady" binderror="onFirstImageReady" />
        <view wx:else class="illustration"></view>
        <view class="slide-title">{{item.title}}</view>
        <view class="slide-desc">{{item.desc}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="bottom">
    <view class="dots">
      <view
        wx:for="{{slides}}"
        wx:key="title"
        class="dot {{current === index ? 'active' : ''}}"
      ></view>
    </view>
    <button class="next" bindtap="onNext">
      {{current === slides.length - 1 ? '开始使用' : '下一步'}}
    </button>
  </view>
</view>
