<view class="post-detail-page">
  <block wx:if="{{post}}">
    <view class="detail-card">
      <view class="post-head">
        <image
          class="post-avatar"
          src="{{postAvatarSrc || post.userAvatar || staticAssets['avatar-placeholder.png']}}"
          mode="aspectFill"
        />
        <view class="post-author">
          <view class="author-name">{{post.username || '宠友'}}</view>
          <view class="post-time">{{timeText}}</view>
        </view>
      </view>

      <view class="post-title">{{post.title}}</view>
      <view class="post-content">{{post.content}}</view>

      <view wx:if="{{photos.length}}" class="photo-list">
        <image
          wx:for="{{photos}}"
          wx:key="*this"
          class="detail-photo"
          src="{{item}}"
          mode="widthFix"
        />
      </view>

      <view class="post-actions">
        <view class="action" bindtap="toggleLike">
          <image class="action-image {{liked ? 'is-liked' : 'not-liked'}}" src="{{staticAssets['community/like.png']}}" mode="aspectFit" />
          <text>{{post.likeCount || 0}}</text>
        </view>
        <view class="action">
          <image class="action-image" src="{{staticAssets['community/comment.png']}}" mode="aspectFit" />
          <text>{{post.commentCount || 0}}</text>
        </view>
      </view>
    </view>

    <view class="comment-card">
      <view class="comment-head">
        <text class="comment-title">评论 <text class="comment-count">· {{post.commentCount || 0}}</text></text>
      </view>

      <view wx:if="{{comments.length}}" class="comment-list">
        <view wx:for="{{comments}}" wx:key="id" class="comment-item">
          <image
            class="comment-avatar"
            src="{{item.avatarSrc || item.displayAvatar}}"
            mode="aspectFill"
          />
          <view class="comment-main">
            <view class="comment-meta">
              <text class="comment-user">{{item.displayName}}</text>
              <text class="comment-time">{{item.timeText}}</text>
            </view>
            <view class="comment-content">
              <text wx:if="{{item.replyToUsername}}" class="reply-to">
                回复 @{{item.replyToUsername}}：
              </text>
              {{item.content}}
            </view>
          </view>
        </view>
      </view>

      <view wx:elif="{{!commentsLoading}}" class="comment-empty">
        还没有评论，聊聊吧
      </view>

      <view
        wx:if="{{commentsHasMore}}"
        class="comment-more"
        bindtap="loadMoreComments"
      >
        {{commentsLoadingMore ? '加载中…' : '加载更多评论'}}
      </view>
    </view>

    <view class="comment-bar">
      <input
        class="comment-input"
        value="{{commentContent}}"
        placeholder="说点什么…"
        placeholder-class="placeholder"
        maxlength="200"
        bindinput="onCommentInput"
        confirm-type="send"
        bindconfirm="sendComment"
      />
      <view class="send-btn {{commentContent ? 'active' : ''}}" bindtap="sendComment">
        发送
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !post}}" class="empty">
    <view class="empty-emoji">🐾</view>
    <view class="empty-title">帖子不存在或已被删除</view>
  </view>
</view>
