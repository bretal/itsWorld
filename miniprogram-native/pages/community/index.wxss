page{background:#fff7fb;color:#2c2633;}
.community-page{min-height:100vh;padding-bottom:calc(174rpx + env(safe-area-inset-bottom));background:radial-gradient(ellipse at 100% 0,#f4e7ff,transparent 54%),radial-gradient(ellipse at 0 45%,#ffedf2,transparent 65%),#fff9fb;}
.community-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:28rpx 34rpx 14rpx;}
.community-title{font-size:44rpx;font-weight:800;letter-spacing:1rpx;}
.community-sub{margin-top:7rpx;font-size:24rpx;color:#9b8ba3;}
.head-paw{width:76rpx;height:76rpx;flex-shrink:0;border-radius:50%;border:2rpx solid white;background:#ffffffb8;display:flex;align-items:center;justify-content:center;font-size:35rpx;color:#ad76d9;box-shadow:0 6rpx 18rpx #c3a3d528;}
.tabs{display:flex;align-items:center;gap:40rpx;padding:6rpx 38rpx 24rpx;}
.tab{position:relative;padding:12rpx 4rpx;font-size:29rpx;color:#9a8b9f;}
.tab.active{color:#ac70dc;font-weight:750;}
.tab.active::after{content:'';position:absolute;left:50%;bottom:0;width:32rpx;height:6rpx;margin-left:-16rpx;border-radius:6rpx;background:#b681e0;}
.feed{padding:0 28rpx;}
.post-card{padding:25rpx 26rpx 18rpx;margin-bottom:18rpx;border:2rpx solid #fff;border-radius:30rpx;background:#ffffffed;box-shadow:0 8rpx 25rpx #bfa4cf18;}
.post-head{display:flex;align-items:center;}
.post-avatar{width:70rpx;height:70rpx;flex-shrink:0;border-radius:50%;background:#f0e5ff;border:2rpx solid #fff;}
.post-author{flex:1;min-width:0;padding-left:16rpx;}
.author-name{font-size:28rpx;font-weight:650;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
.post-time{font-size:22rpx;color:#a395ad;margin-top:3rpx;}
.post-more{font-size:29rpx;color:#b4a3bf;letter-spacing:2rpx;}
.post-title{margin-top:17rpx;font-size:31rpx;font-weight:750;line-height:1.5;word-break:break-all;}
.post-content{margin-top:7rpx;font-size:27rpx;line-height:1.7;color:#645a6c;white-space:pre-wrap;word-break:break-all;}
.post-photos{margin-top:17rpx;display:flex;flex-wrap:wrap;gap:10rpx;}
.post-photo{display:block;border-radius:18rpx;background:#f4eef7;}
.single-photo .post-photo{width:100%;height:340rpx;border-radius:20rpx;}
.photo-grid .post-photo{width:calc((100% - 20rpx)/3);height:196rpx;}
.post-actions{display:flex;align-items:center;gap:40rpx;margin-top:18rpx;padding-top:13rpx;border-top:1rpx solid #f1e7f7;}
.action{display:flex;align-items:center;justify-content:flex-start;gap:8rpx;min-height:45rpx;font-size:24rpx;color:#9986a7;}
.action-icon{font-size:32rpx;color:#a18bad;line-height:1;}
.action-icon.liked{color:#ff7ca5;}
button.share-action{width:auto;max-width:none;flex:0 0 auto;margin:0;padding:0;background:transparent;border:0;line-height:1.5;font-weight:400;}
button.share-action::after{border:0;}
.follow-empty{border-radius:30rpx;background:#ffffffcf;border:2rpx solid white;}
.empty-title{font-size:27rpx;color:#9b87a7;max-width:520rpx;}
.empty-btn{margin-top:24rpx;padding:13rpx 38rpx;border-radius:30rpx;background:#f1e3ff;color:#a16cd0;font-size:25rpx;}
.list-footer{padding:20rpx 0 30rpx;text-align:center;font-size:22rpx;letter-spacing:2rpx;color:#b199bd;}
@media(max-width:360px){.community-sub{font-size:22rpx;}.photo-grid .post-photo{height:180rpx;}}
.action-image{width:44rpx;height:44rpx;flex-shrink:0;}
.action-image.not-liked{filter:grayscale(1);opacity:.55;}
.action-image.is-liked{filter:none;opacity:1;}
