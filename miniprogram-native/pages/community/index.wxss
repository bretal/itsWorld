.community-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f7f8fa;
}

.community-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  background: linear-gradient(150deg, #eef6ff 0%, #f7f8fa 100%);
}

.community-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2329;
}

.community-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.head-paw {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 35, 41, 0.06);
}

.tabs {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 20rpx;
}

.tab {
  position: relative;
  margin-right: 40rpx;
  padding: 10rpx 4rpx;
  font-size: 28rpx;
  color: #8a8f99;
}

.tab.active {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 800;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -4rpx;
  width: 28rpx;
  height: 6rpx;
  margin-left: -14rpx;
  border-radius: 3rpx;
  background: #2f80ed;
}

.feed {
  padding: 0 32rpx;
}

.post-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.post-head {
  display: flex;
  align-items: center;
}

.post-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #eaf2ff;
}

.post-author {
  flex: 1;
  padding-left: 16rpx;
}

.author-name {
  font-size: 27rpx;
  font-weight: 600;
}

.post-time {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #a3a8b0;
}

.post-more {
  color: #b0b4bb;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.post-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.post-content {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #3a3f46;
}

.post-photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.post-photo {
  width: 196rpx;
  height: 196rpx;
  border-radius: 18rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f0f2f5;
}

.post-actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f4f7;
}

.action {
  display: flex;
  align-items: center;
  margin-right: 44rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.action-icon {
  margin-right: 6rpx;
  font-size: 29rpx;
}

.action-icon.liked {
  color: #ff7a9e;
}

.follow-empty {
  background: #ffffff;
  border-radius: 28rpx;
}

.empty-title {
  margin-top: 4rpx;
  font-size: 27rpx;
  color: #8a8f99;
  max-width: 520rpx;
}

.empty-btn {
  margin-top: 26rpx;
  padding: 14rpx 42rpx;
  border-radius: 32rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 25rpx;
  font-weight: 500;
}

.list-footer {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
}
