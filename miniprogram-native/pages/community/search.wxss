@import "../profile/follows.wxss";

.search-page { padding-top: 24rpx; }
.search-form { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.search-field { position: relative; flex: 1 1 0%; min-width: 0; padding: 0 72rpx 0 24rpx; border-radius: 38rpx; background: #fff; }
input.search-input { display: block; width: 100%; height: 76rpx; line-height: 76rpx; color: #34263f; font-size: 28rpx; }
.search-placeholder { color: #75647e; }
button.search-clear { position: absolute; top: 7rpx; right: 8rpx; margin: 0; padding: 0; width: 62rpx; max-width: none; height: 62rpx; line-height: 62rpx; color: #75647e; background: transparent; font-size: 36rpx; }
.search-clear::after { border: 0; }
button.search-submit { flex: 0 0 116rpx; width: 116rpx; min-width: 116rpx; max-width: none; min-height: 76rpx; line-height: 56rpx; }
