<view class="health-page">
  <view class="health-hero">
    <view class="hero-circle circle-a"></view>
    <view class="hero-circle circle-b"></view>

    <view wx:if="{{currentPet}}" class="hero-pet">
      <image
        class="hero-avatar"
        src="{{petAvatarSrc || currentPet.avatarUrl || staticAssets['pet-placeholder.png']}}"
        mode="aspectFill"
      />
      <view class="hero-info">
        <view class="hero-name">{{currentPet.petName}}</view>
        <view class="hero-sub">用心记录，陪伴每一步</view>
      </view>
    </view>

    <view wx:else class="hero-empty" bindtap="goCreatePet">
      <view class="hero-empty-title">还没有宠物档案</view>
      <view class="hero-empty-desc">添加宠物后，开始记录健康数据</view>
      <view class="hero-empty-btn">添加宠物</view>
    </view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <view class="content">
    <block wx:if="{{activeTab === 'weight'}}">
      <view class="summary-card weight-summary">
        <image class="summary-icon" src="{{staticAssets['health/health-weight-scale.png']}}" mode="aspectFit"/>
        <view class="summary-label">最新体重</view>
        <view class="summary-value">{{currentWeight}}<text class="summary-unit">kg</text></view>
        <view class="summary-bottom"><text>{{weightRecords.length ? weightRecords[0].dateText : '还没有体重记录'}}</text><view class="add-btn" data-type="weight" bindtap="openSheet">+ 记录体重</view></view>
      </view>
      <view wx:if="{{weightBars.length > 1}}" class="summary-card trend-card">
        <view class="summary-label">体重变化</view><view class="trend-caption">最近{{weightBars.length}}个记录日 · 按实际日期展示</view>
        <canvas class="trend-image" canvas-id="weightTrend" style="width: {{chartWidth}}px; height: 210px;"/>
      </view>
      <view wx:elif="{{!loading}}" class="first-record"><view>{{weightBars.length ? '第一次记录，成长有了起点' : '从第一次称重，开始记录成长'}}</view><text>{{weightBars.length ? '再记录一个日期，即可查看体重变化' : '添加体重记录，留存TA的成长变化'}}</text></view>
      <view class="section-head">
        <view class="section-title">体重记录</view>
      </view>

      <view class="record-list">
        <view wx:for="{{weightRecords}}" wx:key="id" class="record-row">
          <view class="record-main">
            <view class="record-title">{{item.weightKg}} kg</view>
            <view class="record-sub">{{item.dateText}}</view>
          </view>
          <view
            class="record-delete"
            data-type="weight"
            data-id="{{item.id}}"
            bindtap="deleteRecord"
          >删除</view>
        </view>
        <view wx:if="{{!loading && !weightRecords.length}}" class="empty">
          <view class="empty-emoji">⚖️</view>
          <view class="empty-title">还没有体重记录</view>
        </view>

        <view wx:if="{{loadingMore}}" class="list-footer">加载中…</view>
        <view wx:elif="{{!weightHasMore && weightRecords.length}}" class="list-footer">没有更多了</view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'feeding'}}">
      <view class="summary-card">
        <view class="summary-head">
          <view>
            <image class="summary-icon" src="{{staticAssets['health/health-feeding-bowl.png']}}" mode="aspectFit"/><view class="summary-label">今日喂食</view>
            <view class="summary-value">{{todayFeedingCount}}<text class="summary-unit">次</text></view>
          </view>
          <view class="add-btn" data-type="feeding" bindtap="openSheet">+ 记录喂食</view>
        </view>
        <view class="summary-tip">{{today}} · 记录每一餐，陪伴每一天</view>
      </view>

      <view class="section-head"><view class="section-title">今日记录</view></view>
      <view class="record-list">
        <view wx:for="{{feedingRecords}}" wx:key="id" class="feeding-card">
          <view class="feeding-dot"></view>
          <view class="feeding-main">
            <view class="record-title">{{item.mealLabel}} · {{item.timeText}}</view>
            <view class="record-sub">
              {{item.amountG ? item.amountG + 'g' : '未记录份量'}}{{item.notes ? ' · ' + item.notes : ''}}
            </view>
          </view>
          <view
            class="record-delete"
            data-type="feeding"
            data-id="{{item.id}}"
            bindtap="deleteRecord"
          >删除</view>
        </view>
        <view wx:if="{{!loading && !feedingRecords.length}}" class="empty">
          <view class="empty-emoji">🍚</view>
          <view class="empty-title">今天还没有喂食记录</view>
        </view>

        <view wx:if="{{loadingMore}}" class="list-footer">加载中…</view>
        <view wx:elif="{{!feedingHasMore && feedingRecords.length}}" class="list-footer">没有更多了</view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'vaccine'}}">
      <view class="summary-card archive-summary"><image class="summary-icon" src="{{staticAssets['health/health-vaccine-vial.png']}}" mode="aspectFit"/><view class="summary-label">疫苗档案</view><view class="archive-desc">留存每一次接种记录</view><view class="add-btn" data-type="vaccine" bindtap="openSheet">+ 添加记录</view></view>
      <view class="section-head">
        <view class="section-title">疫苗记录</view>
      </view>

      <view class="record-list">
        <view wx:for="{{vaccineRecords}}" wx:key="id" class="record-card">
          <view class="record-card-head">
            <view class="record-title">{{item.vaccineName}}</view>
            <view
              class="record-delete"
              data-type="vaccine"
              data-id="{{item.id}}"
              bindtap="deleteRecord"
            >删除</view>
          </view>
          <view class="record-sub">接种日期：{{item.vaccinatedText}}</view>
          <view wx:if="{{item.nextDueText}}" class="record-sub">下次接种：{{item.nextDueText}}</view>
          <view wx:if="{{item.vetClinic}}" class="record-sub">医院：{{item.vetClinic}}</view>
          <view wx:if="{{item.notes}}" class="record-notes">{{item.notes}}</view>
        </view>
        <view wx:if="{{!loading && !vaccineRecords.length}}" class="empty">
          <view class="empty-emoji">💉</view>
          <view class="empty-title">还没有疫苗记录</view>
        </view>

        <view wx:if="{{loadingMore}}" class="list-footer">加载中…</view>
        <view wx:elif="{{!vaccineHasMore && vaccineRecords.length}}" class="list-footer">没有更多了</view>
      </view>
    </block>

    <block wx:else>
      <view class="summary-card archive-summary"><image class="summary-icon" src="{{staticAssets['health/health-medical-kit.png']}}" mode="aspectFit"/><view class="summary-label">体检档案</view><view class="archive-desc">把检查发现和医生建议好好保存</view><view class="add-btn" data-type="checkup" bindtap="openSheet">+ 添加体检</view></view>
      <view class="section-head">
        <view class="section-title">体检记录</view>
      </view>

      <view class="record-list">
        <view wx:for="{{checkupRecords}}" wx:key="id" class="record-card">
          <view class="record-card-head">
            <view class="record-title">{{item.dateText}} 体检</view>
            <view
              class="record-delete"
              data-type="checkup"
              data-id="{{item.id}}"
              bindtap="deleteRecord"
            >删除</view>
          </view>
          <view wx:if="{{item.vetClinic}}" class="record-sub">医院：{{item.vetClinic}}</view>
          <view wx:if="{{item.findings}}" class="record-notes">体检发现：{{item.findings}}</view>
          <view wx:if="{{item.recommendations}}" class="record-notes">建议：{{item.recommendations}}</view>
        </view>
        <view wx:if="{{!loading && !checkupRecords.length}}" class="empty">
          <view class="empty-emoji">🩺</view>
          <view class="empty-title">还没有体检记录</view>
        </view>

        <view wx:if="{{loadingMore}}" class="list-footer">加载中…</view>
        <view wx:elif="{{!checkupHasMore && checkupRecords.length}}" class="list-footer">没有更多了</view>
      </view>
    </block>
  </view>

  <view wx:if="{{sheetVisible}}" class="sheet-mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheetVisible}}" class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-title">{{sheetTitle}}</view>

    <scroll-view class="sheet-body" scroll-y>
      <block wx:if="{{sheetType === 'weight'}}">
        <view class="field">
          <text class="field-label">体重（kg）</text>
          <input
            class="field-input"
            type="digit"
            data-field="weightValue"
            value="{{weightValue}}"
            placeholder="如：28.5"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
        <view class="field">
          <text class="field-label">日期</text>
          <picker mode="date" value="{{weightDate}}" end="{{today}}" bindchange="onWeightDateChange">
            <view class="picker-value">{{weightDate}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
      </block>

      <block wx:elif="{{sheetType === 'feeding'}}">
        <view class="field">
          <text class="field-label">餐次</text>
          <picker range="{{feedingTypes}}" value="{{feedingTypeIndex}}" bindchange="onFeedingTypeChange">
            <view class="picker-value">{{feedingTypes[feedingTypeIndex]}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">份量（g）</text>
          <input
            class="field-input"
            type="digit"
            data-field="feedingAmount"
            value="{{feedingAmount}}"
            placeholder="如：120"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
        <view class="field">
          <text class="field-label">时间</text>
          <picker mode="time" value="{{feedingTime}}" bindchange="onFeedingTimeChange">
            <view class="picker-value">{{feedingTime}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">备注</text>
          <input
            class="field-input"
            data-field="feedingNotes"
            value="{{feedingNotes}}"
            placeholder="如：狗粮、湿粮"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
      </block>

      <block wx:elif="{{sheetType === 'vaccine'}}">
        <view class="field">
          <text class="field-label">疫苗名称</text>
          <input
            class="field-input"
            data-field="vaccineName"
            value="{{vaccineName}}"
            placeholder="如：狂犬疫苗"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
        <view class="field">
          <text class="field-label">接种日期</text>
          <picker mode="date" value="{{vaccineDate}}" end="{{today}}" bindchange="onVaccineDateChange">
            <view class="picker-value">{{vaccineDate}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">下次接种</text>
          <picker mode="date" value="{{vaccineNextDate}}" bindchange="onVaccineNextDateChange">
            <view class="picker-value {{vaccineNextDate ? '' : 'placeholder'}}">{{vaccineNextDate || '可选'}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">医院</text>
          <input
            class="field-input"
            data-field="vaccineClinic"
            value="{{vaccineClinic}}"
            placeholder="可选"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
        <view class="field">
          <text class="field-label">备注</text>
          <input
            class="field-input"
            data-field="vaccineNotes"
            value="{{vaccineNotes}}"
            placeholder="可选"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
      </block>

      <block wx:else>
        <view class="field">
          <text class="field-label">体检日期</text>
          <picker mode="date" value="{{checkupDate}}" end="{{today}}" bindchange="onCheckupDateChange">
            <view class="picker-value">{{checkupDate}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">医院</text>
          <input
            class="field-input"
            data-field="checkupClinic"
            value="{{checkupClinic}}"
            placeholder="可选"
            placeholder-class="placeholder"
            bindinput="onFormInput"
          />
        </view>
        <view class="field field-column">
          <text class="field-label">体检发现</text>
          <textarea
            class="field-textarea"
            data-field="checkupFindings"
            value="{{checkupFindings}}"
            placeholder="记录体检结果"
            placeholder-class="placeholder"
            auto-height
            bindinput="onFormInput"
          />
        </view>
        <view class="field field-column">
          <text class="field-label">医生建议</text>
          <textarea
            class="field-textarea"
            data-field="checkupRecommendations"
            value="{{checkupRecommendations}}"
            placeholder="记录医生建议"
            placeholder-class="placeholder"
            auto-height
            bindinput="onFormInput"
          />
        </view>
      </block>
    </scroll-view>

    <button
      class="btn-primary sheet-save"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="saveRecord"
    >
      保存
    </button>
  </view>
</view>
