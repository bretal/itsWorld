<view class="home">
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <view class="header-glow glow-a"></view>
    <view class="header-glow glow-b"></view>

    <view class="nav-row">
      <view class="nav-title" bindtap="togglePetPicker">
        <text>我的宠物</text>
        <text class="chevron">⌄</text>
      </view>

    </view>

    <view class="hero-copy"><view>把每一天，宠成好时光</view><text>记录成长 · 用心陪伴</text></view>
    <view wx:if="{{loading}}" class="pet-card pet-card-loading">
      <view class="skeleton skeleton-avatar"></view>
      <view class="skeleton-lines">
        <view class="skeleton skeleton-line"></view>
        <view class="skeleton skeleton-line short"></view>
      </view>
    </view>

    <view
      wx:elif="{{currentPet}}"
      class="pet-card"
      bindtap="goPetDetail"
    >
      <view class="pet-avatar-wrap">
        <image
          class="pet-avatar"
          src="{{petAvatarSrc || currentPet.avatarUrl || staticAssets['pet-placeholder.png']}}"
          mode="aspectFill"
        />
        <view class="heart">♥</view>
      </view>

      <view class="pet-info">
        <view class="pet-name">{{currentPet.petName}}</view>
        <view class="pet-meta">{{currentPet.metaText}}</view>
        <text wx:if="{{todayDiary && todayDiary.greeting}}" class="mood-bubble">☺ {{moodLabels[todayDiary.greeting] || todayDiary.greeting}}</text>
      </view>
    </view>

    <view wx:else class="pet-card empty-pet-card" bindtap="goCreatePet">
      <view class="empty-pet-icon">🐾</view>
      <view class="empty-pet-info">
        <view class="empty-pet-title">还没有宠物档案</view>
        <view class="empty-pet-desc">添加第一只宠物，开始记录吧</view>
      </view>
      <view class="empty-pet-add">+</view>
    </view>
  </view>

  <view class="body">
    <view class="record-banner" bindtap="goRecordDiary"><image src="{{staticAssets['member/paw.png']}}" mode="aspectFit"/><view><view>今天的小可爱，值得被记录</view><text>留住每一个心动瞬间</text></view><text class="record-action">写日记 ›</text></view>
    <view class="tools-panel"><view class="panel-heading">陪伴日常<text>TA的每件小事，都很重要</text></view>
    <view class="feature-grid">
      <view class="feature" data-key="ai" bindtap="onTapFeature">
        <image class="feature-icon ai" src="{{staticAssets['member/task-photo.png']}}" mode="aspectFit"/>
        <text class="feature-name">拍照识情绪</text>
        <text class="feature-tag">即将上线</text>
      </view>
      <view class="feature" data-key="diary" bindtap="onTapFeature">
        <image class="feature-icon diary" src="{{staticAssets['profile-menu/order-list.png']}}" mode="aspectFit"/>
        <text class="feature-name">宠物日记</text>
      </view>
      <view class="feature" data-key="health" bindtap="onTapFeature">
        <image class="feature-icon health" src="{{staticAssets['profile-menu/favorite-heart.png']}}" mode="aspectFit"/>
        <text class="feature-name">健康管理</text>
      </view>
      <view class="feature" data-key="album" bindtap="onTapFeature">
        <image class="feature-icon album" src="{{staticAssets['profile-menu/album.png']}}" mode="aspectFit"/>
        <text class="feature-name">成长相册</text>
      </view>
    </view></view>
    <view class="tools-panel service-panel"><view class="panel-heading">宠爱生活<text>给TA多一点偏爱</text></view><view class="feature-grid">
      <view class="feature" bindtap="goGrooming">
        <image class="feature-icon grooming" src="{{staticAssets['member/benefit-beauty.png']}}" mode="aspectFit"/>
        <text class="feature-name">美容服务</text>
      </view>
      <view class="feature" bindtap="goShop">
        <image class="feature-icon shop" src="{{staticAssets['profile-menu/shopping-cart.png']}}" mode="aspectFit"/>
        <text class="feature-name">宠物商城</text>
      </view>
      <view class="feature" bindtap="goPackages">
        <image class="feature-icon package" src="{{staticAssets['profile-menu/custom-gift.png']}}" mode="aspectFit"/>
        <text class="feature-name">宠物套餐</text>
      </view>
      <view class="feature" bindtap="goStores">
        <image class="feature-icon store" src="{{staticAssets['profile-menu/map-location.png']}}" mode="aspectFit"/>
        <text class="feature-name">附近门店</text>
      </view>
    </view>

    </view>
    <view class="section-head">
      <view class="section-title">陪伴时光</view>
      <view class="section-more" bindtap="goAlbum">
        <text>更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{todayDiary}}" class="diary-card" bindtap="goTodayDiary">
      <view class="diary-top">
        <image
          class="diary-avatar"
          src="{{petAvatarSrc || currentPet.avatarUrl || staticAssets['pet-placeholder.png']}}"
          mode="aspectFill"
        />
        <view class="diary-meta">
          <view class="diary-name">{{currentPet.petName}}</view>
          <view class="diary-time">{{todayDiaryTime}}</view>
        </view>
        <view class="diary-badge">今日打卡</view>
      </view>

      <view class="diary-content">
        {{todayDiary.content || todayDiary.greeting || '今天也留下了可爱的记录~'}}
      </view>

      <view wx:if="{{todayPhotos.length}}" class="diary-photos">
        <image
          wx:for="{{todayPhotos}}"
          wx:key="*this"
          class="diary-photo"
          src="{{item}}"
          mode="aspectFill"
        />
      </view>

      <view class="diary-foot">
        <text class="diary-health" wx:if="{{todayDiary.healthScore}}">
          健康评分 {{todayDiary.healthScore}}
        </text>
        <view class="diary-like">
          <text class="like-icon">♡</text>
          <text>{{todayDiary.likeCount || 0}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty-diary card" bindtap="goRecordDiary">
      <view class="empty-diary-emoji">🌤️</view>
      <view class="empty-diary-title">今天还没有记录</view>
      <view class="empty-diary-desc">拍张照片，记下TA今天的小情绪吧</view>
      <view class="empty-diary-btn">去记录</view>
    </view>
    <view class="home-footer">每一份陪伴，都是给TA的礼物</view>
  </view>

  <view wx:if="{{petPickerVisible}}" class="sheet-mask" bindtap="closePetPicker"></view>
  <view
    wx:if="{{petPickerVisible}}"
    class="pet-sheet"
    catchtap="noop"
  >
    <view class="sheet-handle"></view>
    <view class="sheet-title">切换宠物</view>
    <view class="sheet-list">
      <view
        wx:for="{{pets}}"
        wx:key="id"
        class="sheet-item {{currentPet.id === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPet"
      >
        <image
          class="sheet-avatar"
          src="{{item.avatarSrc || item.avatarUrl || staticAssets['pet-placeholder.png']}}"
          mode="aspectFill"
        />
        <view class="sheet-info">
          <view class="sheet-name">{{item.petName}}</view>
          <view class="sheet-meta">{{item.metaText}}</view>
        </view>
        <text wx:if="{{currentPet.id === item.id}}" class="sheet-check">✓</text>
      </view>
    </view>
    <view class="sheet-manage" bindtap="goManagePets">管理宠物</view>
    <view class="sheet-cancel" bindtap="closePetPicker">取消</view>
  </view>
</view>

<view class="assistant-float">
  <view wx:if="{{assistantPromptVisible}}" class="assistant-speech">
    <navigator class="assistant-speech-text" url="/pages/assistant/chat" open-type="navigate" bindfail="onAssistantNavigationFail">{{assistantPrompt}}</navigator>
    <button class="assistant-speech-close" bindtap="dismissAssistantPrompt" aria-label="关闭气泡提示">×</button>
  </view>
  <navigator class="assistant-float-link" url="/pages/assistant/chat" open-type="navigate" bindfail="onAssistantNavigationFail" aria-label="打开宠物助手">
    <image class="assistant-float-icon" src="/assets/shop/silver-maine-coon-ear-flick-wink.gif" mode="aspectFit" />
    <text class="assistant-float-label">宠物助手</text>
  </navigator>
</view>
