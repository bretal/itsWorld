.home {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f7f8fa;
}

.header {
  position: relative;
  padding: 20rpx 32rpx 44rpx;
  background: linear-gradient(160deg, #8ccafb 0%, #5aa9f8 52%, #2f80ed 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}

.header-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.glow-a {
  width: 300rpx;
  height: 300rpx;
  top: -120rpx;
  right: -80rpx;
}

.glow-b {
  width: 220rpx;
  height: 220rpx;
  bottom: -110rpx;
  left: -60rpx;
  background: rgba(255, 255, 255, 0.1);
}

.nav-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.nav-title {
  display: flex;
  align-items: center;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
}

.chevron {
  margin-left: 10rpx;
  font-size: 32rpx;
  margin-top: -6rpx;
  opacity: 0.9;
}

.camera-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  color: #ffffff;
  font-size: 34rpx;
}

.pet-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 40rpx rgba(23, 78, 166, 0.16);
}

.pet-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.pet-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 28rpx;
  background: #eaf2ff;
}

.heart {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #ff7a9e;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.12);
}

.pet-info {
  flex: 1;
  min-width: 0;
  padding-left: 28rpx;
}

.pet-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
}

.pet-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.mood-bubble {
  display: block;
  align-self: flex-start;
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 5rpx 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 30rpx;
}

.pet-card-loading {
  height: 204rpx;
}

.skeleton {
  background: #eef2f7;
  border-radius: 16rpx;
}

.skeleton-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 28rpx;
}

.skeleton-lines {
  flex: 1;
  padding-left: 28rpx;
}

.skeleton-line {
  height: 28rpx;
  margin-bottom: 18rpx;
}

.skeleton-line.short {
  width: 55%;
}

.empty-pet-card {
  padding: 28rpx;
}

.empty-pet-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: #eaf2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.empty-pet-info {
  flex: 1;
  padding-left: 24rpx;
}

.empty-pet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-pet-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.empty-pet-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #2f80ed;
  color: #ffffff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.body {
  padding: 28rpx 32rpx 0;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feature {
  position: relative;
  width: 48%;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.feature-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 18rpx;
}

.feature-icon.ai {
  background: #eaf2ff;
}

.feature-icon.diary {
  background: #f3edff;
}

.feature-icon.health {
  background: #fff0f3;
}

.feature-icon.album {
  background: #edf8ee;
}

.feature-icon.grooming {
  background: #eaf2ff;
}

.feature-icon.shop {
  background: #fff4e8;
}

.feature-icon.package {
  background: #fff8e1;
}

.feature-icon.store {
  background: #eef7f1;
}

.feature-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
}

.feature-tag {
  position: absolute;
  right: 16rpx;
  top: 14rpx;
  font-size: 18rpx;
  color: #b0b4bb;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 4rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8a8f99;
}

.more-arrow {
  margin-left: 4rpx;
  font-size: 30rpx;
  margin-top: -2rpx;
}

.diary-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.diary-top {
  display: flex;
  align-items: center;
}

.diary-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eaf2ff;
}

.diary-meta {
  flex: 1;
  padding-left: 18rpx;
}

.diary-name {
  font-size: 27rpx;
  font-weight: 600;
}

.diary-time {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #a3a8b0;
}

.diary-badge {
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  background: #eaf6ff;
  color: #2f80ed;
  font-size: 20rpx;
}

.diary-content {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #3a3f46;
}

.diary-photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.diary-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f0f2f5;
}

.diary-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.diary-health {
  font-size: 22rpx;
  color: #5b8d4a;
  background: #f2f8ef;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
}

.diary-like {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #8a8f99;
}

.like-icon {
  margin-right: 6rpx;
  font-size: 28rpx;
  color: #ff8fb1;
}

.empty-diary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.empty-diary-emoji {
  font-size: 72rpx;
}

.empty-diary-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-diary-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8f99;
  text-align: center;
}

.empty-diary-btn {
  margin-top: 24rpx;
  padding: 14rpx 42rpx;
  border-radius: 32rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 25rpx;
  font-weight: 500;
}

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(17, 24, 39, 0.42);
}

.pet-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  padding: 18rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #ffffff;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e3e5e8;
  margin: 0 auto 22rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.sheet-list {
  max-height: 520rpx;
  overflow-y: auto;
}

.sheet-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
}

.sheet-item.active {
  background: #f5f9ff;
}

.sheet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eaf2ff;
}

.sheet-info {
  flex: 1;
  padding-left: 18rpx;
}

.sheet-name {
  font-size: 28rpx;
  font-weight: 600;
}

.sheet-meta {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.sheet-check {
  color: #2f80ed;
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-manage {
  margin-top: 16rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-cancel {
  margin-top: 12rpx;
  height: 76rpx;
  color: #8a8f99;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.home{background:linear-gradient(150deg,#fff5ee,#fff0f8 40%,#f3edff);color:#392942}.header{background:linear-gradient(125deg,#ffeadb,#f9e0f2 55%,#e6d7ff);border-radius:0 0 56rpx 56rpx}.nav-title{color:#392942}.nav-row{padding-right:190rpx}.hero-copy{position:relative;padding:20rpx 4rpx 28rpx}.hero-copy view{font-size:42rpx;font-weight:700;letter-spacing:2rpx}.hero-copy text{display:block;margin-top:12rpx;font-size:24rpx;color:#9b789e;letter-spacing:4rpx}.pet-card{margin-top:0;border:2rpx solid white;background:linear-gradient(120deg,#ffffffef,#fffaffcc);box-shadow:0 14rpx 32rpx #9c6cb81f}.pet-avatar{width:164rpx;height:176rpx;border:4rpx solid white;border-radius:30rpx}.pet-name{color:#392942}.pet-meta{color:#99869d}.mood-bubble{background:#f1e7fb;color:#8d63ab;border-radius:24rpx 24rpx 24rpx 6rpx}.body{padding:26rpx 28rpx 0}.record-banner{display:flex;align-items:center;padding:22rpx 18rpx;margin-bottom:24rpx;background:linear-gradient(110deg,#ffedcc,#ffe0e9 60%,#efdcff);border:2rpx solid white;border-radius:30rpx}.record-banner image{width:72rpx;height:72rpx;margin-right:12rpx;flex-shrink:0}.record-banner>view{flex:1;min-width:0}.record-banner>view>view{font-size:25rpx;font-weight:600;color:#75482d}.record-banner>view>text{display:block;margin-top:8rpx;font-size:21rpx;color:#ac8193}.record-action{padding:16rpx 20rpx;border-radius:40rpx;color:white;font-size:23rpx;background:linear-gradient(#ffbe50,#ff901c);border:2rpx solid #fff5d8}.tools-panel{padding:28rpx 12rpx 12rpx;margin-bottom:24rpx;border-radius:36rpx;border:2rpx solid white;background:#ffffffaa;box-shadow:0 12rpx 28rpx #d8bce51c}.panel-heading{padding:0 16rpx 22rpx;font-size:32rpx;font-weight:700}.panel-heading text{margin-left:16rpx;color:#ab91ad;font-size:21rpx;font-weight:400}.feature-grid{justify-content:flex-start}.feature{box-sizing:border-box;width:25%;margin:0;padding:0 0 22rpx;flex-direction:column;background:transparent;box-shadow:none;border-radius:0}.feature-icon{display:block;width:100rpx;height:100rpx;margin:0 0 10rpx;border-radius:0}.feature-icon.ai,.feature-icon.diary,.feature-icon.health,.feature-icon.album,.feature-icon.grooming,.feature-icon.shop,.feature-icon.package,.feature-icon.store{background:transparent}.feature-name{color:#56435e;font-size:24rpx;font-weight:500}.feature-tag{top:-4rpx;right:0;font-size:16rpx;border-radius:12rpx;padding:2rpx 6rpx;background:#f0e9f5;color:#a28aad}.section-head{margin:32rpx 8rpx 20rpx}.section-title{color:#4b3156}.section-more{color:#a187ac}.diary-card,.empty-diary{border:2rpx solid white;border-radius:34rpx;background:#ffffffcc;box-shadow:0 12rpx 28rpx #d8bce526}.diary-badge{background:#f2e5ff;color:#a16bc3}.empty-diary-btn,.empty-pet-add{background:linear-gradient(120deg,#cba4ee,#ac83db);color:white}.sheet-item.active,.sheet-manage{background:#f5eafd}.sheet-check,.sheet-manage{color:#a375bd}.home-footer{text-align:center;padding:36rpx 0 16rpx;color:#b49dbd;font-size:21rpx;letter-spacing:3rpx}

/* 宠物资料保持稳定横向布局，心情文字与表情在同一行。 */
.pet-card { align-items: center; padding: 28rpx; }
.pet-avatar-wrap { width: 164rpx; flex: 0 0 164rpx; }
.pet-avatar { width: 164rpx; height: 176rpx; }
.pet-info { display: flex; flex-direction: column; align-items: flex-start; padding-left: 24rpx; overflow: hidden; }
.pet-name { width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 1.35; }
.pet-meta { width: 100%; font-size: 23rpx; line-height: 1.5; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.assistant-float { position: fixed; z-index: 20; right: 20rpx; bottom: calc(128rpx + 24px + env(safe-area-inset-bottom)); width: 216rpx; min-height: 118rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.assistant-float-icon { width: 216rpx; height: 216rpx; }
.assistant-float-label { margin-top: -10rpx; padding: 5rpx 12rpx; border-radius: 20rpx; background: #8855b9; color: #fff; font-size: 20rpx; line-height: 1.3; box-shadow: 0 4rpx 12rpx #8c59b650; }

.assistant-speech {
  position: absolute;
  right: 177rpx;
  bottom: 56rpx;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  width: max-content;
  max-width: 260rpx;
  border: 1rpx solid #e4d4f0;
  border-radius: 20rpx;
  background: #fff;
  color: #392747;
  box-shadow: 0 3rpx 10rpx rgba(70, 39, 96, .14);
}
.assistant-speech-text {
  min-width: 0;
  padding: 12rpx 0 12rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.35;
  word-break: break-word;
}
.assistant-speech::after {
  position: absolute;
  right: -8rpx;
  bottom: 15rpx;
  width: 13rpx;
  height: 13rpx;
  border-top: 1rpx solid #e4d4f0;
  border-right: 1rpx solid #e4d4f0;
  background: #fff;
  transform: rotate(45deg);
  content: "";
  pointer-events: none;
}

.assistant-float-link { display: flex; flex-direction: column; align-items: center; }
.assistant-speech-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #6e4e85;
  font-size: 31rpx;
  line-height: 1;
}
.assistant-speech-close::after { border: 0; }
