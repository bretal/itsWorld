.pet-list-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f7f8fa;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2329;
}

.list-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.add-btn {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(47, 128, 237, 0.24);
}

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 8rpx 8rpx 8rpx 26rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(31, 35, 41, 0.04);
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.search-placeholder {
  color: #b0b4bb;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f2f5;
  color: #8a8f99;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn {
  margin-left: 8rpx;
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.pet-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 26rpx;
  background: #eaf2ff;
}

.pet-main {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.pet-line {
  display: flex;
  align-items: center;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.current-badge {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 18rpx;
}

.pet-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.pet-weight {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a3a8b0;
}

.pet-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.mini-btn {
  margin-bottom: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #f5f7fa;
  color: #5a6472;
  font-size: 20rpx;
}

.mini-btn.primary {
  background: #eaf2ff;
  color: #2f80ed;
}

.mini-btn.danger {
  background: #fff0f2;
  color: #e05b6f;
}

.empty-title {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: #8a8f99;
}

.empty-btn {
  margin-top: 26rpx;
  padding: 14rpx 42rpx;
  border-radius: 32rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 25rpx;
  font-weight: 500;
}

.list-footer {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
}
