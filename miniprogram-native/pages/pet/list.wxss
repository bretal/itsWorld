.pet-list-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fcf5ed;
  color: #241b19;
}

.pet-list-page button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0;
  line-height: 1.2;
}

.pet-list-page button::after {
  border: 0;
}

.list-head {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(120deg, #fce8da, #ffe0ca);
}

.head-paw,
.empty-paw {
  flex: none;
  width: 88rpx;
  height: 88rpx;
}

.head-copy {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx 0 12rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid #e9ad8a;
}

.head-title {
  color: #382117;
  font-size: 34rpx;
  font-weight: 800;
}

.list-sub {
  color: #895338;
  font-size: 24rpx;
}

.pet-list-page .gold {
  min-height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #ffbe6d, #ef9433);
  color: #452505;
  font-size: 25rpx;
  font-weight: 700;
}

.pet-list-page .add-btn {
  width: 146rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  min-height: 70rpx;
  margin: 24rpx 0 32rpx;
  padding: 0 16rpx 0 26rpx;
  border: 2rpx solid #cfc1b9;
  border-radius: 24rpx;
  background: #fffaf6;
}

.search-icon {
  position: relative;
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 22rpx;
  border: 3rpx solid #827674;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -5rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 9rpx;
  background: #827674;
  transform: rotate(45deg);
  content: '';
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  font-size: 27rpx;
}

.search-placeholder {
  color: #766d69;
}

.pet-list-page .search-clear {
  width: 58rpx;
  height: 58rpx;
  color: #766d69;
  font-size: 36rpx;
}

.pet-item {
  position: relative;
  margin-bottom: 22rpx;
  border: 2rpx solid #e5d7cc;
  border-radius: 28rpx;
  background: #fffbf6;
}

.pet-item-current {
  border-color: #d4b5e9;
  background: linear-gradient(140deg, #f7effc, #f2e5f8);
}

.pet-summary {
  display: flex;
  align-items: flex-start;
  min-height: 208rpx;
  padding: 18rpx;
}

.pet-avatar {
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 23rpx;
  background: #efe0df;
}

.pet-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding: 7rpx 0 0;
}

.pet-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
  min-height: 44rpx;
  padding-right: 64rpx;
}

.pet-name {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-badge {
  flex: none;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: #e6d2f1;
  color: #543560;
  font-size: 21rpx;
  font-weight: 600;
}

.pet-meta,
.pet-weight {
  overflow: hidden;
  color: #5c5153;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-meta {
  margin-top: 8rpx;
}

.pet-weight {
  margin-top: 6rpx;
  padding-right: 154rpx;
}

.pet-item-current .pet-weight {
  padding-right: 0;
}

.pet-list-page .more-btn,
.pet-list-page .current-btn {
  position: absolute;
  right: 18rpx;
}

.pet-list-page .more-btn {
  top: 12rpx;
  width: 64rpx;
  height: 60rpx;
  color: #625455;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.pet-list-page .current-btn {
  bottom: 24rpx;
  width: 144rpx;
  min-height: 52rpx;
  border: 2rpx solid #a86f65;
  border-radius: 999rpx;
  color: #834c45;
  font-size: 23rpx;
  font-weight: 600;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 44rpx 20rpx;
  border: 2rpx solid #e5d7cc;
  border-radius: 28rpx;
  background: #fffbf6;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 700;
}

.pet-list-page .empty-btn {
  width: 240rpx;
}

.list-footer {
  padding: 24rpx 0 34rpx;
  text-align: center;
  font-size: 24rpx;
  color: #776962;
}
