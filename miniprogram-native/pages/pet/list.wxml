<view class="pet-list-page">
  <view class="list-head">
    <image class="head-paw" src="./paw-charm.png" mode="aspectFit" />
    <view class="head-copy">
      <view class="head-title">宠物档案</view>
      <view class="list-sub">共 {{total}} 只毛孩子</view>
    </view>
    <button class="add-btn gold" bindtap="goAdd">＋ 添加</button>
  </view>

  <view class="search-bar">
    <view class="search-icon" aria-hidden="true"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索名字或品种"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <button wx:if="{{keyword}}" class="search-clear" aria-label="清空搜索" bindtap="onClearSearch">×</button>
  </view>

  <view class="pet-list">
    <view
      wx:for="{{pets}}"
      wx:key="id"
      class="pet-item {{item.current ? 'pet-item-current' : ''}}"
    >
      <view class="pet-summary" data-id="{{item.id}}" bindtap="goDetail">
        <image
          class="pet-avatar"
          src="{{item.avatarSrc || item.avatarUrl || staticAssets['pet-placeholder.png']}}"
          mode="aspectFill"
        />
        <view class="pet-main">
          <view class="pet-line">
            <text class="pet-name">{{item.petName}}</text>
            <text wx:if="{{item.current}}" class="current-badge">当前宠物</text>
          </view>
          <view class="pet-meta">{{item.metaText}}</view>
          <view class="pet-weight">体重 {{item.weight || '--'}} kg</view>
        </view>
      </view>
      <view class="pet-actions">
        <button class="more-btn" aria-label="管理{{item.petName}}" bindtap="openActions" data-id="{{item.id}}">···</button>
        <button
          wx:if="{{!item.current}}"
          class="current-btn"
          bindtap="setCurrent"
          data-id="{{item.id}}"
        >
          设为当前
        </button>
      </view>
    </view>

    <view wx:if="{{!loading && !pets.length}}" class="empty">
      <image class="empty-paw" src="./paw-charm.png" mode="aspectFit" />
      <view class="empty-title">{{keyword ? '没有找到相关宠物' : '还没有宠物档案'}}</view>
      <button wx:if="{{!keyword}}" class="empty-btn gold" bindtap="goAdd">添加第一只宠物</button>
    </view>

    <view wx:if="{{loading || loadingMore}}" class="list-footer">加载中…</view>
    <view wx:elif="{{!hasMore && pets.length}}" class="list-footer">没有更多了</view>
  </view>
</view>
