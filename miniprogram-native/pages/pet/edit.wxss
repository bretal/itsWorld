.pet-edit-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 36rpx;
}

.avatar-picker {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eaf2ff;
  box-shadow: 0 14rpx 32rpx rgba(31, 35, 41, 0.08);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  background: rgba(31, 35, 41, 0.45);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a3a8b0;
}

.form-card {
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f3f5f8;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #5a6472;
}

.required {
  color: #e05b6f;
}

.form-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.placeholder {
  color: #c5c9cf;
}

.form-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #1f2329;
}

.picker-value.placeholder {
  color: #c5c9cf;
}

.picker-arrow {
  margin-left: 8rpx;
  color: #c0c4ca;
  font-size: 34rpx;
}

.form-hint {
  padding: 0 0 16rpx 180rpx;
  font-size: 21rpx;
  color: #b0b4bb;
}

.form-item-textarea {
  align-items: flex-start;
  padding: 28rpx 0;
}

.form-textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.6;
}

.save-btn {
  width: 100%;
  margin-top: 40rpx;
}
