.pet-edit-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(42rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 100% 80%, #e9b7f7, transparent 75%),
    linear-gradient(150deg, #fff1e3, #fbe5f5 60%, #f4dafa);
  color: #2e1c3e;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 190rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #fff;
  border-radius: 40rpx;
  background: linear-gradient(105deg, #b99af8, #f5baf2);
  box-shadow: inset 0 0 18rpx rgba(255, 255, 255, 0.45);
}

.avatar-picker {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border: 2rpx solid #ffffff70;
  border-radius: 50%;
  background: #ffffff38;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.camera-icon {
  position: relative;
  width: 49rpx;
  height: 36rpx;
  border: 4rpx solid #fff;
  border-radius: 9rpx;
}

.camera-icon::before,
.camera-icon::after {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  content: '';
}

.camera-icon::before {
  top: -10rpx;
  width: 18rpx;
  height: 7rpx;
  border: 3rpx solid #fff;
  border-bottom: 0;
  border-radius: 6rpx 6rpx 0 0;
  background: #cdb1f5;
}

.camera-icon::after {
  top: 5rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
}

.avatar-copy {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
  border-left: 2rpx solid #ffffffa0;
}

.avatar-title {
  font-size: 34rpx;
  font-weight: 800;
}

.avatar-tip {
  color: #59416c;
  font-size: 23rpx;
}

.pet-edit-page button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 1.2;
}

.pet-edit-page button::after {
  border: 0;
}

.pet-edit-page .gold {
  border: 2rpx solid #fff6df;
  border-radius: 999rpx;
  background: linear-gradient(110deg, #ffce57, #ff9c25);
  box-shadow: 0 8rpx 18rpx rgba(168, 78, 23, 0.19);
  color: #fff;
  font-weight: 800;
}

.pet-edit-page .gold[disabled] {
  opacity: 0.65;
}

.pet-edit-page .avatar-button {
  flex: none;
  width: 178rpx;
  height: 62rpx;
  font-size: 25rpx;
}

.form-card {
  padding: 22rpx 18rpx 26rpx;
  border: 2rpx solid #fff;
  border-radius: 42rpx;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.72), rgba(249, 233, 255, 0.56));
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.form-heading {
  margin: 0 8rpx 20rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.form-heading text {
  color: #b76500;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  margin-bottom: 10rpx;
  padding: 9rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.68);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  flex: none;
  width: 180rpx;
  margin-right: 22rpx;
  border-right: 2rpx solid #dcc8f5;
  font-size: 28rpx;
  font-weight: 700;
}

.required {
  color: #b44718;
}

.form-input,
.form-picker,
.gender-options {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
}

.form-input {
  height: 58rpx;
}

.placeholder {
  color: #71637c;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
}

.picker-arrow {
  padding-left: 12rpx;
  color: #6e597e;
  font-size: 36rpx;
}

.form-hint {
  margin: 0 20rpx 10rpx;
  color: #71637c;
  font-size: 22rpx;
}

.gender-options {
  display: flex;
  gap: 12rpx;
}

.pet-edit-page .gender-button {
  flex: 1;
  min-width: 0;
  min-height: 54rpx;
  border: 2rpx solid #af80e9;
  border-radius: 999rpx;
  background: #faf3ff;
  color: #573678;
  font-size: 26rpx;
}

.pet-edit-page .gender-button.selected {
  border-color: #7950ac;
  background: #e7d3fc;
  color: #351c53;
  font-weight: 700;
}

.pet-edit-page .save-btn {
  width: 82%;
  min-height: 84rpx;
  margin: 34rpx auto 0;
  font-size: 34rpx;
}
