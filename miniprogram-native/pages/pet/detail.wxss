.pet-detail-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f7f8fa;
}

.pet-hero {
  position: relative;
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(150deg, #8ccafb 0%, #5aa9f8 54%, #2f80ed 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.circle-a {
  width: 280rpx;
  height: 280rpx;
  top: -120rpx;
  right: -80rpx;
}

.circle-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -70rpx;
  left: -40rpx;
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  background: #ffffff;
}

.hero-edit {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 23rpx;
}

.hero-name {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 800;
}

.hero-meta {
  position: relative;
  z-index: 2;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
}

.hero-bio {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
}

.stat-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 8rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.stat-unit {
  margin-left: 2rpx;
  font-size: 20rpx;
  font-weight: 400;
}

.stat-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.24);
}

.tabs {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}

.tab {
  margin-right: 40rpx;
  padding: 10rpx 4rpx;
  font-size: 28rpx;
  color: #8a8f99;
}

.tab.active {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 800;
}

.tab-content {
  padding: 12rpx 32rpx 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.record-link {
  font-size: 24rpx;
  color: #2f80ed;
}

.timeline {
  position: relative;
  padding-left: 28rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 2rpx;
  background: #e3e8ef;
}

.timeline-item {
  position: relative;
  margin-bottom: 22rpx;
}

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2f80ed;
  border: 4rpx solid #dfeaff;
}

.timeline-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.timeline-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2329;
}

.timeline-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3a3f46;
}

.timeline-photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.timeline-photo {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  margin: 0 10rpx 10rpx 0;
  background: #f0f2f5;
}

.health-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.health-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.health-title {
  font-size: 24rpx;
  color: #8a8f99;
}

.health-value {
  margin-top: 6rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #1f2329;
}

.health-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8f99;
}

.health-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff0f3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.health-tip {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  color: #8a8f99;
  font-size: 23rpx;
  line-height: 1.6;
}

.health-btn {
  margin-top: 22rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-card {
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f5f8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row-column {
  flex-direction: column;
  align-items: flex-start;
}

.info-label {
  font-size: 25rpx;
  color: #8a8f99;
}

.info-value {
  font-size: 26rpx;
  color: #1f2329;
}

.info-bio {
  margin-top: 10rpx;
  line-height: 1.7;
  color: #3a3f46;
}

.empty-title {
  margin-top: 4rpx;
  font-size: 27rpx;
  color: #8a8f99;
}

.empty-btn {
  margin-top: 26rpx;
  padding: 14rpx 42rpx;
  border-radius: 32rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 25rpx;
  font-weight: 500;
}

.list-footer {
  padding: 18rpx 0 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
}
