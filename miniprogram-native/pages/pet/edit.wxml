<view class="pet-edit-page">
  <view class="avatar-section">
    <view class="avatar-picker" bindtap="chooseAvatar">
      <image wx:if="{{avatarPreviewSrc || avatarUrl}}" class="avatar-image"
        src="{{avatarPreviewSrc || avatarUrl}}" mode="aspectFill" />
      <view wx:else class="camera-icon" aria-hidden="true"></view>
    </view>
    <view class="avatar-copy">
      <view class="avatar-title">上传头像</view>
      <view class="avatar-tip">选填</view>
    </view>
    <button class="gold avatar-button" disabled="{{uploading || saving}}" bindtap="chooseAvatar">
      {{uploading ? '上传中…' : '选择照片'}}
    </button>
  </view>

  <view class="form-card">
    <view class="form-heading"><text aria-hidden="true">✦</text> 基本信息</view>
    <view class="form-item">
      <text class="form-label">名字 <text class="required">*</text></text>
      <input
        class="form-input"
        data-field="petName"
        value="{{petName}}"
        placeholder="输入宠物名字"
        placeholder-class="placeholder"
        maxlength="50"
        bindinput="onInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">类型 <text class="required">*</text></text>
      <picker
        class="form-picker"
        range="{{petTypes}}"
        value="{{petTypeIndex}}"
        disabled="{{isEdit}}"
        bindchange="onPetTypeChange"
      >
        <view class="picker-value {{petTypeIndex === 0 ? 'placeholder' : ''}}">
          {{petTypes[petTypeIndex]}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <view wx:if="{{isEdit}}" class="form-hint">宠物类型创建后暂不支持修改</view>

    <view class="form-item">
      <text class="form-label">品种</text>
      <input
        class="form-input"
        data-field="breed"
        value="{{breed}}"
        placeholder="如：布偶猫"
        placeholder-class="placeholder"
        maxlength="50"
        bindinput="onInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <view class="gender-options">
        <button class="gender-button {{gender === 1 ? 'selected' : ''}}"
          aria-pressed="{{gender === 1}}" data-value="1" bindtap="onGenderChange">公</button>
        <button class="gender-button {{gender === 2 ? 'selected' : ''}}"
          aria-pressed="{{gender === 2}}" data-value="2" bindtap="onGenderChange">母</button>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">生日</text>
      <picker
        class="form-picker"
        mode="date"
        value="{{birthDate}}"
        end="{{today}}"
        bindchange="onBirthDateChange"
      >
        <view class="picker-value {{birthDate ? '' : 'placeholder'}}">
          {{birthDate || '选择出生日期'}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">体重（kg）</text>
      <input
        class="form-input"
        data-field="weight"
        type="digit"
        value="{{weight}}"
        placeholder="请输入"
        placeholder-class="placeholder"
        bindinput="onInput"
      />
    </view>
  </view>

  <button
    class="gold save-btn"
    loading="{{saving}}"
    disabled="{{saving || uploading}}"
    bindtap="onSave"
  >
    {{isEdit ? '保存修改' : '添加宠物'}}
  </button>
</view>
