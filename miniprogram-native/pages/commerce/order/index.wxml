<view class="page">
  <scroll-view scroll-x class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTapTab"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="tip">加载中...</view>
  <view wx:elif="{{!orders.length}}" class="tip">暂无订单</view>
  <view wx:else class="list">
    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="card"
      data-no="{{item.orderNo}}"
      bindtap="goDetail"
    >
      <view class="card-head">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="card-body">
        <view class="title">{{item.firstTitle}}</view>
        <view class="meta">共 {{item.itemCount}} 件 · {{item.timeText}}</view>
      </view>
      <view class="card-foot">
        <text class="amount">应付 ¥{{item.payableText}}</text>
        <text class="more">查看详情 ›</text>
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="tip">加载更多...</view>
</view>
