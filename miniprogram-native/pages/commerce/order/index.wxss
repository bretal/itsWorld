.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.tabs {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5f6673;
  font-size: 24rpx;
}

.tab.active {
  background: #2f80ed;
  color: #ffffff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 22rpx;
  color: #8a8f99;
}

.status {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f80ed;
}

.card-body {
  margin-top: 18rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.card-foot {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f1f3f6;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount {
  font-size: 26rpx;
  color: #f0564a;
  font-weight: 600;
}

.more {
  font-size: 23rpx;
  color: #2f80ed;
}

.tip {
  padding: 60rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 26rpx;
}
