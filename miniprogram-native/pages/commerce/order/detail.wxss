.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.status-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2f80ed 0%, #5b9cff 100%);
  color: #ffffff;
}

.status {
  font-size: 38rpx;
  font-weight: 700;
}

.status-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.order-no {
  margin-top: 18rpx;
  font-size: 21rpx;
  opacity: 0.8;
}

.card {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 14rpx;
}

.address {
  font-size: 25rpx;
  line-height: 1.6;
  color: #5f6673;
}

.item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f3f6;
}

.item:last-child {
  border-bottom: none;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.spec {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a8f99;
}

.row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 25rpx;
  color: #f0564a;
}

.qty {
  font-size: 21rpx;
  color: #8a8f99;
}

.line-total {
  margin-left: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2329;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 25rpx;
  color: #5f6673;
}

.orders-btn {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 27rpx;
}

.orders-btn::after {
  border: none;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: #5f6673;
  font-size: 27rpx;
}

.pay-btn {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 27rpx;
}

.cancel-btn::after,
.pay-btn::after {
  border: none;
}

.tip {
  padding: 120rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 27rpx;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: #5f6673;
  font-size: 25rpx;
}

.action-btn.primary {
  background: #2f80ed;
  color: #ffffff;
}

.action-btn::after {
  border: none;
}
