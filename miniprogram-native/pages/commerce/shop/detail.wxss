.page {
  min-height: 100vh;
  padding: 0 24rpx 200rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.swiper {
  height: 520rpx;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

.banner {
  width: 100%;
  height: 520rpx;
  background: #eef1f6;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 42rpx;
  font-weight: 700;
  color: #f0564a;
}

.member {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #2f80ed;
}

.name {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8a8f99;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 14rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku {
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e8ebf1;
  background: #f7f8fa;
  font-size: 24rpx;
  color: #5f6673;
  display: flex;
  flex-direction: column;
}

.sku.active {
  border-color: #2f80ed;
  background: #eaf2ff;
  color: #2f80ed;
}

.sku.disabled {
  opacity: 0.45;
}

.sku-member {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #2f80ed;
}

.stock {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.desc {
  font-size: 25rpx;
  line-height: 1.7;
  color: #5f6673;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.cart-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: #2f80ed;
  font-size: 28rpx;
}

.buy-btn {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 29rpx;
}

.cart-btn::after,
.buy-btn::after {
  border: none;
}

.tip {
  padding: 120rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 27rpx;
}
