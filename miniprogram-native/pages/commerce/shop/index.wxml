<view class="page">
  <view class="hero">
    <view class="hero-title">宠物商城</view>
    <view class="hero-sub">精选零食与日常好物</view>
  </view>

  <scroll-view scroll-x class="tabs">
    <view class="tab {{activeCategoryId === 0 ? 'active' : ''}}" data-id="0" bindtap="onTapCategory">全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="tab {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="tip">加载中...</view>
  <view wx:elif="{{!products.length}}" class="tip">暂无上架商品</view>
  <view wx:else class="product-grid">
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-card"
      data-id="{{item.id}}"
      bindtap="goProductDetail"
    >
      <image class="product-cover" src="{{item.coverSrc || staticAssets['pet-placeholder.png']}}" mode="aspectFill" />
      <view class="product-name">{{item.name}}</view>
      <view class="product-sub">{{item.subtitle || item.categoryName || ''}}</view>
      <view class="product-price">
        ¥{{item.priceText}}
        <text wx:if="{{item.memberPriceText}}" class="member">{{item.memberPriceText}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="tip">加载更多...</view>
</view>
