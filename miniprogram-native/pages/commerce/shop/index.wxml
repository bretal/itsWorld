<view class="shop-page">
  <view class="shop-toolbar">
    <view class="toolbar-copy"><view class="toolbar-title">每一口，都是宠爱</view></view>
    <view class="toolbar-actions">
      <button class="cart-button" bindtap="goCart" aria-label="查看购物车">
        <image src="{{asset}}03_01_add_to_cart.png" mode="aspectFit" />
        <text wx:if="{{cartCount}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</text>
      </button>
      <button class="contact-button" open-type="contact" aria-label="联系商城客服"><image src="{{asset}}01_08_customer_service.png" mode="aspectFit" /></button>
    </view>
  </view>
  <view class="search-bar">
    <image class="search-icon" src="{{asset}}01_06_search.png" mode="aspectFit" />
    <input value="{{searchInput}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" placeholder="搜索宠物零食、品牌、口味等" placeholder-class="search-placeholder" aria-label="搜索商品" />
    <button wx:if="{{searchInput}}" class="clear-search" bindtap="clearSearch" aria-label="清除搜索">×</button>
    <button class="search-submit" bindtap="onSearch">搜索</button>
  </view>

  <view class="hero" bindtap="viewAll" role="button" aria-label="浏览全部宠物零食">
    <image class="hero-image" src="{{asset}}shop-hero.jpg" mode="aspectFill" />
    <view class="hero-copy"><view class="hero-kicker">给毛孩子的美味时光</view><view class="hero-title">天然宠物零食</view><view class="hero-sub">健康美味 · 让 TA 更快乐</view></view>
  </view>
  <view class="banner-indicator"><view class="dot active"></view></view>

  <view class="shortcut-panel">
    <button wx:for="{{shortcuts}}" wx:key="name" class="shortcut {{activeShortcut === item.name ? 'selected' : ''}}" data-index="{{index}}" bindtap="onTapShortcut">
      <image src="{{asset}}{{item.icon}}" mode="aspectFit" /><text>{{item.name}}</text>
    </button>
  </view>
  <view class="benefits">
    <view wx:for="{{benefits}}" wx:key="name" class="benefit"><image src="{{asset}}{{item.icon}}" mode="aspectFit" /><text>{{item.name}}</text></view>
  </view>

  <view wx:if="{{recommendations.length}}" class="recommend-section">
    <view class="section-heading"><view class="section-title"><text class="section-symbol">✦</text>今日推荐</view><button class="view-more" bindtap="viewAll">查看更多 <text>›</text></button></view>
    <scroll-view scroll-x class="recommend-scroll" show-scrollbar="{{false}}">
      <view class="recommend-list">
        <view wx:for="{{recommendations}}" wx:key="id" class="recommend-card" data-id="{{item.id}}" bindtap="goProductDetail">
          <view class="recommend-cover product-art"><image wx:if="{{item.coverSrc}}" src="{{item.coverSrc}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError" /><view wx:else class="cover-placeholder"><image src="{{asset}}05_07_paw_print.png" mode="aspectFit" /><text>好物待发现</text></view></view>
          <view class="recommend-name">{{item.name}}</view><view class="product-sub">{{item.subtitle || item.categoryName || '给毛孩子的用心之选'}}</view>
          <view class="price-row"><view class="product-price"><text wx:if="{{item.minPrice != null}}" class="currency">¥</text>{{item.priceText}}</view><button class="add-button" data-id="{{item.id}}" catchtap="goProductDetail" aria-label="选择商品规格"><image src="{{asset}}03_01_add_to_cart.png" mode="aspectFit" /></button></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="discovery-banner" bindtap="viewAll" role="button" aria-label="浏览精选好物">
    <view class="discovery-copy"><view class="discovery-title"><image src="{{asset}}05_02_gold_crown.png" mode="aspectFit" />宠爱，从一口好滋味开始</view><view class="discovery-sub">发现毛孩子的心头好 <text>›</text></view></view>
    <image class="gift-art" src="{{asset}}02_07_gift_box.png" mode="aspectFit" />
  </view>

  <view id="curated" class="curated-section">
    <view class="section-heading"><view class="section-title"><text class="section-symbol tag-symbol">◆</text>精选好物</view><text class="section-note">认真选，只为更宠它</text></view>
    <scroll-view scroll-x class="tabs" show-scrollbar="{{false}}">
      <button class="tab {{activeCategoryId === 0 ? 'active' : ''}}" data-id="0" bindtap="onTapCategory">全部</button>
      <button wx:for="{{categories}}" wx:key="id" class="tab {{activeCategoryId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onTapCategory">{{item.name}}</button>
    </scroll-view>
    <view wx:if="{{keyword}}" class="search-summary">“{{keyword}}” 的搜索结果 <text bindtap="clearSearch">清除</text></view>
    <view wx:if="{{loading}}" class="empty-state"><view class="loading-paw">✦</view><text>正在挑选美味好物…</text></view>
    <view wx:elif="{{loadError && !products.length}}" class="empty-state"><text class="empty-title">好物暂时没加载出来</text><text>请检查网络后重试</text><button class="state-button" bindtap="retry">重新加载</button></view>
    <view wx:elif="{{!products.length}}" class="empty-state"><image src="{{asset}}01_01_cat_snack.png" mode="aspectFit" /><text class="empty-title">还没有找到合适的好物</text><text>试试其他分类或关键词吧</text><button class="state-button" bindtap="viewAll">看看全部商品</button></view>
    <view wx:else class="product-grid">
      <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="goProductDetail">
        <view class="product-cover product-art"><image wx:if="{{item.coverSrc}}" src="{{item.coverSrc}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="onImageError" /><view wx:else class="cover-placeholder"><image src="{{asset}}05_07_paw_print.png" mode="aspectFit" /><text>好物待发现</text></view></view>
        <view class="product-body"><view class="product-name">{{item.name}}</view><view class="product-sub">{{item.subtitle || item.categoryName || '给毛孩子的用心之选'}}</view><view wx:if="{{item.memberPriceText}}" class="member-price">{{item.memberPriceText}}</view>
          <view class="price-row"><view class="product-price"><text wx:if="{{item.minPrice != null}}" class="currency">¥</text>{{item.priceText}}</view><button class="add-button" data-id="{{item.id}}" catchtap="goProductDetail" aria-label="选择商品规格"><image src="{{asset}}03_01_add_to_cart.png" mode="aspectFit" /></button></view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="list-footer">正在加载更多好物…</view>
    <button wx:elif="{{loadError && products.length}}" class="state-button" bindtap="retry">加载失败，点击重试</button>
    <view wx:elif="{{products.length && !hasMore}}" class="list-footer">— 每一份宠爱，都值得认真挑选 —</view>
  </view>
</view>
