<view wx:if="{{loading}}" class="tip">加载中...</view>
<view wx:elif="{{detail}}" class="page">
  <swiper wx:if="{{imageUrls.length}}" class="swiper" indicator-dots circular>
    <swiper-item wx:for="{{imageUrls}}" wx:key="*this">
      <image class="banner" src="{{item || staticAssets['pet-placeholder.png']}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="card">
    <view class="price-row">
      <text class="price">¥{{priceText}}</text>
      <text wx:if="{{memberPriceText}}" class="member">{{memberPriceText}}</text>
    </view>
    <view class="name">{{detail.name}}</view>
    <view class="subtitle" wx:if="{{detail.subtitle}}">{{detail.subtitle}}</view>
  </view>

  <view class="card" wx:if="{{skus.length}}">
    <view class="section-title">选择规格</view>
    <view class="sku-list">
      <view
        wx:for="{{skus}}"
        wx:key="id"
        class="sku {{selectedSkuId === item.id ? 'active' : ''}} {{item.status !== 'ENABLED' ? 'disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectSku"
      >
        <text>{{item.specText}}</text>
        <text wx:if="{{item.memberPriceText}}" class="sku-member">{{item.memberPriceText}}</text>
      </view>
    </view>
    <view class="stock">库存：{{stockText}}</view>
  </view>

  <view class="card" wx:if="{{detail.description}}">
    <view class="section-title">商品详情</view>
    <rich-text class="desc" nodes="{{detail.description}}"></rich-text>
  </view>

  <view class="footer">
    <button class="cart-btn" bindtap="goCart">购物车</button>
    <button class="buy-btn" bindtap="addToCart">加入购物车</button>
  </view>
</view>
<view wx:else class="tip">商品不存在或已下架</view>
