<view wx:if="{{loading}}" class="tip">加载中...</view>
<view wx:elif="{{detail}}" class="page">
  <image class="cover" src="{{coverSrc || staticAssets['pet-placeholder.png']}}" mode="aspectFill" />
  <view class="card">
    <view class="name">{{detail.name}}</view>
    <view class="meta">{{detail.categoryName || '美容'}} · {{detail.durationMin}} 分钟</view>
    <view class="price-row">
      <text class="price">¥{{priceText}}</text>
      <text wx:if="{{memberPriceText}}" class="member">{{memberPriceText}}</text>
    </view>
    <view wx:if="{{petText}}" class="pet-status {{detail.petEligible === false ? 'bad' : 'good'}}">{{petText}}</view>
  </view>

  <view class="card" wx:if="{{detail.description}}">
    <view class="section-title">服务说明</view>
    <text class="desc">{{detail.description}}</text>
  </view>

  <view class="card" wx:if="{{ruleTexts.length}}">
    <view class="section-title">适用宠物</view>
    <view wx:for="{{ruleTexts}}" wx:key="*this" class="rule">{{item}}</view>
  </view>

  <view class="footer">
    <button class="book-btn active" bindtap="goBooking">立即预约</button>
  </view>
</view>
<view wx:else class="tip">服务不存在或已下架</view>
