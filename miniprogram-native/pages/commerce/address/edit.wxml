<view class="page">
  <view class="form">
    <view class="field">
      <text class="label">收货人</text>
      <input class="input" value="{{form.recipientName}}" data-field="recipientName" bindinput="onInput" placeholder="请输入收货人姓名" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" placeholder="请输入手机号" />
    </view>
    <view class="field">
      <text class="label">省份</text>
      <input class="input" value="{{form.province}}" data-field="province" bindinput="onInput" placeholder="省" />
    </view>
    <view class="field">
      <text class="label">城市</text>
      <input class="input" value="{{form.city}}" data-field="city" bindinput="onInput" placeholder="市" />
    </view>
    <view class="field">
      <text class="label">区县</text>
      <input class="input" value="{{form.district}}" data-field="district" bindinput="onInput" placeholder="区/县" />
    </view>
    <view class="field">
      <text class="label">详细地址</text>
      <input class="input" value="{{form.addressDetail}}" data-field="addressDetail" bindinput="onInput" placeholder="街道、门牌号" />
    </view>
    <view class="field switch-field">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault === 1}}" color="#2f80ed" bindchange="onDefaultChange" />
    </view>
  </view>
  <button class="save-btn" loading="{{saving}}" bindtap="save">保存地址</button>
</view>
