<view class="page">
  <view wx:if="{{loading}}" class="status">正在加载地址…</view>
  <view wx:elif="{{!addressLoaded}}" class="status">无法读取地址，请返回后重试。</view>
  <view wx:else class="content">
    <view class="card">
      <view class="heading">收货人信息</view>
      <view class="field"><text>收货人</text><input value="{{form.recipientName}}" data-field="recipientName" bindinput="onInput" placeholder="请输入姓名" /></view>
      <view class="field"><text>手机号</text><input type="number" maxlength="11" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" placeholder="请输入手机号" /></view>
    </view>
    <view class="card">
      <view class="heading">收货地址</view>
      <picker mode="region" value="{{[form.province, form.city, form.district]}}" bindchange="onRegionChange">
        <view class="field">
          <text>所在地区</text>
          <view class="region-value {{form.province ? '' : 'muted'}}">{{form.province ? form.province + (form.city ? ' · ' + form.city : '') + (form.district ? ' · ' + form.district : '') : '请选择省 / 市 / 区县'}}</view>
          <text class="arrow">›</text>
        </view>
      </picker>
      <view class="detail">
        <text>详细地址</text>
        <textarea value="{{form.addressDetail}}" data-field="addressDetail" bindinput="onInput" maxlength="255" cursor-spacing="24" placeholder="街道、小区、楼栋、门牌号" />
      </view>
    </view>
    <view class="card default-card">
      <view><view class="heading">设为默认收货地址</view><view class="muted hint">下单时优先使用此地址</view></view>
      <switch checked="{{form.isDefault === 1}}" color="#9561c4" bindchange="onDefaultChange" />
    </view>
  </view>
  <view wx:if="{{addressLoaded && !loading}}" class="footer">
    <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存地址</button>
  </view>
</view>
