page { background: #fbf4fc; color: #382b40; }

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(160deg, #fff5ef, #f8edfb 62%, #fcf7ff);
}

.content { padding: 24rpx; }
.card { padding: 24rpx 28rpx; border-radius: 26rpx; background: #fff; }
.card + .card { margin-top: 20rpx; }
.heading { font-size: 30rpx; font-weight: 650; }

.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f1e8f3;
  font-size: 27rpx;
}

.card > .field:last-child { border-bottom: 0; }
.field > text:first-child { flex: 0 0 148rpx; }
.field input, .region-value { flex: 1; min-width: 0; }
.region-value { padding: 14rpx 0; line-height: 1.5; }
.arrow { margin-left: 12rpx; color: #946bad; font-size: 38rpx; }
.muted, .status { color: #786681; }
.status { padding: 48rpx 24rpx; text-align: center; }
.detail { padding-top: 20rpx; font-size: 27rpx; }

.detail textarea {
  box-sizing: border-box;
  width: 100%;
  height: 144rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #faf5fc;
  line-height: 1.55;
}

.default-card { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.hint { margin-top: 8rpx; font-size: 23rpx; }

.footer {
  position: sticky;
  bottom: 0;
  margin-top: auto;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fcf7ff;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #8252b3;
  font-size: 30rpx;
  font-weight: 650;
}

.save-btn::after { border: 0; }
