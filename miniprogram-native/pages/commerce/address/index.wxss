.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2329;
}

.mobile {
  font-size: 24rpx;
  color: #5f6673;
}

.default {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 20rpx;
}

.address {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #5f6673;
}

.actions {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f1f3f6;
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
}

.action {
  font-size: 24rpx;
  color: #2f80ed;
}

.action.danger {
  color: #e5484d;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.add-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 28rpx;
}

.add-btn::after {
  border: none;
}

.empty {
  padding-top: 160rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  color: #1f2329;
}

.tip {
  padding: 120rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 27rpx;
}
