.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #cfd8e6;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
}

.check.checked {
  background: #2f80ed;
  border-color: #2f80ed;
}

.cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: #eef1f6;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invalid {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #e5484d;
}

.bottom {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0564a;
}

.qty {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #f1f4f9;
  color: #1f2329;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.qty-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 26rpx;
}

.remove {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  font-size: 34rpx;
  color: #b0b4bb;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.select-all {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #5f6673;
}

.total {
  flex: 1;
  text-align: right;
  margin-right: 18rpx;
  font-size: 24rpx;
  color: #5f6673;
}

.total-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0564a;
}

.checkout-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 27rpx;
}

.checkout-btn::after {
  border: none;
}

.empty {
  padding-top: 160rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  color: #1f2329;
}

.shop-btn {
  margin-top: 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 27rpx;
}

.tip {
  padding: 120rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 27rpx;
}
