page { background:#fcf4ff; color:#382641; }
.cart-page { min-height:100vh; padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); background:radial-gradient(ellipse at 0 30%,#f4deff,transparent 60%),linear-gradient(150deg,#fff5ed,#f7edff 55%,#fffaff); }
.cart-hero { position:relative; height:285rpx; overflow:hidden; }
.hero-bg { width:100%; height:100%; opacity:.85; }
.hero-message { position:absolute; top:27rpx; left:24%; width:52%; text-align:center; color:#9955d4; font-size:30rpx; font-weight:750; text-shadow:0 2rpx #fff; }
.hero-message text { display:block; font-size:19rpx; font-weight:400; color:#b77f9d; margin-top:7rpx; }
.service { position:absolute; top:10rpx; right:20rpx; display:flex; flex-direction:column; align-items:center; width:65rpx; min-width:0; margin:0; padding:0; font-size:19rpx; color:#72627e; }
.service image { width:56rpx; height:56rpx; transform:scale(1.5); }
.cart-content { position:relative; margin-top:-15rpx; border-radius:42rpx 42rpx 0 0; padding:24rpx 20rpx; background:linear-gradient(180deg,rgba(255,250,255,.9),rgba(255,250,255,.25)); }
.list-heading { position:relative; display:flex; align-items:center; width:100%; min-height:65rpx; padding:4rpx 200rpx 24rpx 8rpx; box-sizing:border-box; }
.selection-summary,.select-all { display:flex; align-items:center; gap:12rpx; font-size:26rpx; font-weight:600; }
.check { flex:0 0 37rpx; width:37rpx; height:37rpx; border-radius:12rpx; border:2rpx solid #d8c5ec; background:#fffaff; color:#fff; text-align:center; line-height:33rpx; font-size:27rpx; }
.check.checked { background:linear-gradient(135deg,#ca8cff,#923fff); border-color:#b261ff; box-shadow:0 3rpx 8rpx #e5c8fa; }
.clear-button { position:absolute; top:0; right:0; display:flex; align-items:center; justify-content:flex-end; width:190rpx; min-width:0; height:44rpx; margin:0 !important; padding:0 !important; border:0; box-sizing:border-box; white-space:nowrap; line-height:44rpx; text-align:right; font-size:23rpx; color:#9983ad; }
.clear-button image { width:39rpx; height:39rpx; transform:scale(1.4); }
.cart-card { display:flex; align-items:center; gap:15rpx; padding:22rpx 18rpx; background:rgba(255,255,255,.86); border:2rpx solid #fff; border-radius:30rpx; margin-bottom:16rpx; box-shadow:0 7rpx 20rpx rgba(156,105,190,.04); }
.cover { flex:0 0 162rpx; width:162rpx; height:180rpx; border-radius:23rpx; overflow:hidden; background:linear-gradient(130deg,#fff0dd,#ffe8f2); }
.cover image { width:100%; height:100%; }
.cover .placeholder { padding:12rpx; }
.item-info { flex:1; min-width:0; }
.name-row { display:flex; align-items:flex-start; justify-content:space-between; gap:5rpx; }
.name { flex:1; min-width:0; font-size:27rpx; font-weight:650; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.remove { flex:0 0 36rpx; width:36rpx; min-width:0; height:36rpx; padding:0; margin:0; }
.remove image { width:100%; height:100%; transform:scale(1.6); }
.spec { display:inline-block; color:#8a7896; background:#fcf8ff; border:2rpx solid #efe4f5; border-radius:16rpx; padding:1rpx 12rpx; margin-top:12rpx; font-size:21rpx; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.invalid { display:block; color:#d58b9c; font-size:20rpx; margin-top:5rpx; }
.item-bottom { display:flex; justify-content:space-between; align-items:flex-end; gap:6rpx; margin-top:18rpx; flex-wrap:wrap; }
.price-block { display:flex; align-items:center; flex-wrap:wrap; gap:5rpx; }
.price { color:#ff6029; font-size:29rpx; font-weight:750; }
.member-tag { font-size:17rpx; background:linear-gradient(100deg,#bc8a68,#a46b91); color:#fff3d8; padding:2rpx 6rpx; border-radius:10rpx; }
.original { font-size:19rpx; color:#b8a5bf; text-decoration:line-through; }
.stepper { display:flex; align-items:center; border:2rpx solid #eae0f1; border-radius:18rpx; overflow:hidden; height:44rpx; }
.stepper button { flex:0 0 40rpx; min-width:0; width:40rpx; height:40rpx; padding:0; margin:0; line-height:40rpx; font-size:29rpx; color:#866597; background:#faf5fe; }
.stepper text { min-width:38rpx; text-align:center; font-size:23rpx; }
.stepper button[disabled] { opacity:.35; }
.benefit-card { margin-top:22rpx; border:2rpx solid #fff; border-radius:30rpx; overflow:hidden; background:rgba(255,255,255,.75); }
.benefit-title,.benefit-row { display:flex; align-items:center; gap:12rpx; padding:18rpx 22rpx; font-size:26rpx; }
.benefit-title { font-weight:650; background:linear-gradient(100deg,#fff5fa,#f6edff); }
.benefit-title image,.benefit-row image { width:40rpx; height:40rpx; transform:scale(1.4); }
.benefit-row + .benefit-row { border-top:2rpx solid #f7effb; }
.benefit-note { margin-left:auto; font-size:21rpx; color:#a58ab4; }
.cart-footer { position:fixed; bottom:0; left:0; right:0; display:flex; align-items:center; gap:15rpx; padding:22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:rgba(255,252,255,.98); box-shadow:0 -5rpx 26rpx rgba(174,125,204,.06); }
.select-all { flex-shrink:0; font-size:25rpx; gap:8rpx; }
.total { flex:1; min-width:0; text-align:right; font-size:23rpx; }
.total view > text { color:#ff6029; font-size:34rpx; font-weight:750; }
.savings { color:#b09cbb; font-size:19rpx; }
.checkout-button,.shop-button { width:auto; min-width:0; margin:0; padding:0 27rpx; height:76rpx; line-height:76rpx; border-radius:45rpx; background:linear-gradient(120deg,#cc83ff,#a347f8); color:#fff; font-size:28rpx; font-weight:650; box-shadow:0 7rpx 15rpx #e9d6fb; white-space:nowrap; }
.checkout-button { flex:0 0 auto; }
.checkout-button[disabled] { opacity:.45; }
.empty-state { display:flex; flex-direction:column; align-items:center; padding:40rpx 20rpx 70rpx; gap:18rpx; }
.empty-art { width:220rpx; height:220rpx; }
.empty-title { font-size:31rpx; font-weight:650; color:#8e5aa9; }
.empty-sub { font-size:24rpx; color:#b29bbd; }
.shop-button { margin-top:15rpx; min-width:280rpx; text-align:center; }
