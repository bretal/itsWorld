<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中...</view>
  <view wx:elif="{{!items.length}}" class="empty">
    <view class="empty-title">购物车还是空的</view>
    <button class="shop-btn" bindtap="goShop">去逛逛</button>
  </view>
  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="id" class="card">
      <view
        class="check {{item.selected === 1 ? 'checked' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggleSelect"
      >{{item.selected === 1 ? '✓' : ''}}</view>
      <image class="cover" src="{{item.coverSrc || staticAssets['pet-placeholder.png']}}" mode="aspectFill" />
      <view class="info">
        <view class="name">{{item.productName}}</view>
        <view class="spec">{{item.specText || item.skuCode || ''}}</view>
        <view wx:if="{{item.invalidReason}}" class="invalid">{{item.invalidReason}}</view>
        <view class="bottom">
          <text class="price">¥{{item.priceText}}</text>
          <view class="qty">
            <view class="qty-btn" data-id="{{item.id}}" data-delta="-1" bindtap="changeQty">-</view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn" data-id="{{item.id}}" data-delta="1" bindtap="changeQty">+</view>
          </view>
        </view>
      </view>
      <view class="remove" data-id="{{item.id}}" bindtap="removeItem">×</view>
    </view>
  </view>

  <view wx:if="{{items.length}}" class="footer">
    <view class="select-all" bindtap="toggleAll">
      <view class="check {{allSelected ? 'checked' : ''}}">{{allSelected ? '✓' : ''}}</view>
      <text>全选</text>
    </view>
    <view class="total">
      <text>合计：</text>
      <text class="total-price">¥{{totalText}}</text>
    </view>
    <button class="checkout-btn" bindtap="goCheckout">结算({{selectedCount}})</button>
  </view>
</view>
