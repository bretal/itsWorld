page { background:#fcf5ff; color:#382b40; }
.checkout-page { min-height:100vh; padding:0 18rpx calc(155rpx + env(safe-area-inset-bottom)); background:radial-gradient(ellipse at 0 20%,#f7e4ff,transparent 60%),linear-gradient(140deg,#fff5ed,#faf0ff 60%,#fffaff); }
.checkout-hero { position:relative; margin:0 -18rpx; height:240rpx; overflow:hidden; }
.checkout-hero > image { width:100%; height:100%; opacity:.8; }
.hero-caption { position:absolute; top:28rpx; left:20%; width:60%; text-align:center; color:#9a62b7; font-size:29rpx; font-weight:650; text-shadow:0 2rpx #fff; }
.hero-caption text { display:block; font-size:20rpx; color:#bb8a9b; margin-top:6rpx; }
.checkout-card { position:relative; padding:24rpx; margin-top:18rpx; border:2rpx solid #fff; border-radius:30rpx; background:rgba(255,255,255,.85); box-shadow:0 8rpx 24rpx rgba(153,106,183,.04); }
.address-card { margin-top:-15rpx; overflow:hidden; padding-bottom:32rpx; }
.section-title { display:flex; align-items:center; gap:12rpx; font-size:30rpx; font-weight:650; margin-bottom:14rpx; }
.section-title image { width:42rpx; height:42rpx; transform:scale(1.5); }
.count { margin-left:auto; font-size:23rpx; font-weight:400; color:#a28db0; }
.address-content { padding:0 34rpx 0 54rpx; }
.address-name { font-size:28rpx; font-weight:600; }
.address-name text { margin-left:15rpx; }
.address-detail { margin-top:8rpx; font-size:24rpx; color:#99859f; line-height:1.6; }
.address-arrow { position:absolute; right:25rpx; top:80rpx; font-size:38rpx; color:#ad96b9; }
.address-empty { display:flex; justify-content:space-between; padding:8rpx 8rpx 8rpx 54rpx; font-size:24rpx; color:#b49bbf; }
.link { color:#a864db; }
.postal-stripe { position:absolute; bottom:0; left:0; right:0; height:8rpx; background:repeating-linear-gradient(135deg,#c895f5 0,#c895f5 25rpx,#fff 25rpx,#fff 40rpx,#ffb6a0 40rpx,#ffb6a0 65rpx,#fff 65rpx,#fff 80rpx); }
.order-item { display:flex; align-items:center; gap:20rpx; padding:15rpx 0; }
.order-item + .order-item { border-top:2rpx solid #f5edf9; }
.cover { flex:0 0 138rpx; width:138rpx; height:138rpx; overflow:hidden; border-radius:21rpx; background:linear-gradient(125deg,#fff0da,#ffe9f2); }
.cover image { width:100%; height:100%; }
.item-info { flex:1; min-width:0; }
.name { font-size:28rpx; font-weight:650; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.spec { margin-top:5rpx; font-size:23rpx; color:#a18baa; }
.price-line { display:flex; align-items:center; gap:12rpx; margin-top:7rpx; }
.price { color:#ff6328; font-size:32rpx; font-weight:750; }
.member-tag { color:#fff3da; background:linear-gradient(100deg,#bc8d70,#a96c87); font-size:18rpx; padding:2rpx 10rpx; border-radius:12rpx; }
.quantity { font-size:27rpx; color:#7f698c; }
.invalid { color:#df8490; font-size:21rpx; }
.amount-row { display:flex; align-items:center; justify-content:space-between; gap:18rpx; min-height:65rpx; font-size:25rpx; color:#85718f; }
.amount-row + .amount-row { border-top:2rpx solid #f8f0fc; }
.row-label { display:flex; align-items:center; gap:12rpx; flex-shrink:0; }
.row-label image { width:37rpx; height:37rpx; transform:scale(1.4); }
.coupon-value { font-size:22rpx; text-align:right; color:#ad72c7; max-width:370rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.discount { color:#ff713d; font-weight:600; }
.muted-value { color:#a38caf; }
.payment-note { color:#b7a1c2; font-size:20rpx; margin-top:12rpx; text-align:center; }
.totals-card .amount-row { min-height:54rpx; font-size:24rpx; }
.final-total { margin-top:8rpx; font-weight:650; }
.final-total text:last-child { color:#ff6328; font-size:30rpx; }
.footer { position:fixed; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:rgba(255,252,255,.98); box-shadow:0 -5rpx 26rpx rgba(162,115,190,.06); }
.footer-total { flex:1; min-width:0; font-size:26rpx; }
.footer-total view > text { color:#ff6328; font-size:43rpx; font-weight:750; }
.footer-note { font-size:19rpx; color:#b29bbe; }
.submit-button { flex:0 0 265rpx; width:265rpx; min-width:0; margin:0; padding:0; height:80rpx; line-height:80rpx; border-radius:45rpx; background:linear-gradient(120deg,#cc86ff,#a148f8); color:#fff; font-size:31rpx; font-weight:650; box-shadow:0 6rpx 16rpx #ead5fb; }
.submit-button[disabled] { opacity:.45; }
.tip,.empty-note { padding:80rpx 20rpx; text-align:center; font-size:25rpx; color:#ac94b8; }
