.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.mine-link {
  font-size: 25rpx;
  color: #2f80ed;
}

.search-bar {
  padding: 0 4rpx 20rpx;
}

.search-input {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.tip {
  padding: 100rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 26rpx;
}

.package-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.cover {
  width: 190rpx;
  height: 190rpx;
  border-radius: 20rpx;
  background: #eef1f6;
}

.info {
  flex: 1;
  margin-left: 22rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.valid {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2f80ed;
}

.item {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.price {
  font-size: 34rpx;
  font-weight: 700;
  color: #f0564a;
}

.arrow {
  color: #9aa0aa;
}
