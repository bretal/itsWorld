<view class="page">
  <view class="filters">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter {{activeStatus === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterChange"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-text">还没有预约记录</view>
    <button class="empty-btn" bindtap="goGrooming">去看看美容服务</button>
  </view>
  <view wx:else class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="booking-card"
      data-no="{{item.bookingNo}}"
      bindtap="goDetail"
    >
      <view class="card-head">
        <view class="service">{{item.serviceName || '美容服务'}}</view>
        <view class="status status-{{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="row"><text class="label">宠物</text><text>{{item.petName || '-'}}</text></view>
      <view class="row"><text class="label">门店</text><text>{{item.storeName || '-'}}</text></view>
      <view class="row"><text class="label">时段</text><text>{{item.dateText}} {{item.timeText}}</text></view>
      <view class="card-foot">
        <text class="booking-no">{{item.bookingNo}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="tip">加载更多...</view>
</view>
