.page {
  min-height: 100vh;
  padding: 0 24rpx 200rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.tip {
  padding: 120rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 27rpx;
}

.status-card {
  margin-top: 20rpx;
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2f80ed, #69a6ff);
  color: #ffffff;
}

.status {
  font-size: 38rpx;
  font-weight: 700;
}

.booking-no {
  margin-top: 12rpx;
  font-size: 23rpx;
  opacity: 0.85;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #1f2329;
}

.label {
  color: #9aa0aa;
}

.link {
  color: #2f80ed;
}

.empty {
  padding: 30rpx 0;
  text-align: center;
  color: #9aa0aa;
  font-size: 25rpx;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slot {
  width: calc((100% - 32rpx) / 3);
  padding: 16rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid #e5e8ee;
  background: #fafbfc;
  text-align: center;
}

.slot.active {
  border-color: #2f80ed;
  background: #edf4ff;
}

.slot-time {
  font-size: 26rpx;
  color: #1f2329;
}

.slot-left {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.confirm-btn {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 27rpx;
}

.confirm-btn::after {
  border: none;
}

.log {
  display: flex;
  padding: 12rpx 0;
}

.log-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #2f80ed;
}

.log-body {
  flex: 1;
}

.log-action {
  font-size: 25rpx;
  color: #1f2329;
}

.log-remark {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.log-time {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #b0b5bd;
}

.list-btn {
  margin-top: 30rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f80ed;
  font-size: 27rpx;
}

.list-btn::after {
  border: none;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.secondary-btn,
.primary-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
}

.secondary-btn {
  background: #eef1f6;
  color: #5f6673;
}

.primary-btn {
  background: #2f80ed;
  color: #ffffff;
}

.secondary-btn::after,
.primary-btn::after {
  border: none;
}
