-plane{width:0;height:0;border-top:14rpx solid transparent;border-bottom:14rpx solid transparent;border-left:35rpx solid white;transform:rotate(-36deg);margin:0 0 0 4rpx}.ai-notice{text-align:center;color:#9a8ca6;font-size:23rpx;padding-top:12rpx}.ai-notice text{color:#ffc432;margin:0 10rpx}.privacy{text-align:center;font-size:17rpx;color:#a397ad;margin-top:6rpx;line-height:1.5}.error{padding:10rpx 30rpx;font-size:23rpx;color:#ab695d;z-index:3}.bottom{height:18rpx}.ambient{position:absolute;border-radius:50%;background:linear-gradient(150deg,#fff,#f4deff);box-shadow:inset 0 8rpx 12rpx #fff}.cloud-one{width:420rpx;height:280rpx;left:-180rpx;bottom:20rpx;opacity:.6}.cloud-two{width:470rpx;height:350rpx;right:-160rpx;bottom:-40rpx;opacity:.7}.history-button{margin:16rpx auto;background:#fff9;color:#805994;font-size:23rpx}
