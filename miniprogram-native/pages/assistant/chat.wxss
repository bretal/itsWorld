.recommendation-overlay { position: fixed; inset: 0; z-index: 60; }
.recommendation-backdrop { position: absolute; inset: 0; background: rgba(28, 15, 43, .4); }
.recommendation-sheet {
  position: absolute; left: 0; right: 0; bottom: 0;
  overflow: hidden;
  border-radius: 34rpx 34rpx 0 0; background: #fff;
  animation: recommendation-enter .22s ease-out;
}
@keyframes recommendation-enter { from { transform: translateY(100%); } to { transform: translateY(0); } }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 0 28rpx; font-size: 30rpx; font-weight: 600; }
.sheet-heading .sheet-close { margin: 0; padding: 0; width: 62rpx; height: 62rpx; line-height: 62rpx; border-radius: 50%; color: #6e4e85; background: #f5edfa; font-size: 40rpx; }

.assistant-pet-picker { position: relative; z-index: 2; align-self: flex-start; margin: 14rpx 24rpx 0; padding: 10rpx 18rpx; border-radius: 28rpx; background: #fff; color: #795491; font-size: 24rpx; }


.quick-questions { width: 100%; overflow: hidden; padding: 4rpx 0 12rpx; }
.quick-question { flex: 0 0 auto; width: auto; margin: 0; padding: 12rpx 20rpx; border-radius: 32rpx; background: #fff; color: #69477e; font-size: 24rpx; line-height: 1.4; white-space: nowrap; }

.quick-question-track { display: inline-flex; width: max-content; animation: quick-questions-marquee 18s linear infinite; }
.quick-question-track.is-paused { animation-play-state: paused; }
.quick-question-group { display: flex; flex: 0 0 auto; gap: 12rpx; padding-right: 12rpx; }
@keyframes quick-questions-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

.assistant-nav { position: relative; flex-shrink: 0; z-index: 3; }
.assistant-nav-row { position: relative; display: flex; align-items: center; justify-content: center; }
.assistant-nav-title { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; color: #241a2e; font-size: 30rpx; font-weight: 600; }
.assistant-nav-back { position: absolute; left: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 64rpx; min-width: 0; height: 100%; box-sizing: border-box; margin: 0; padding: 0; background: transparent; }
.assistant-nav-arrow { width: 20rpx; height: 20rpx; border-left: 3rpx solid #241a2e; border-bottom: 3rpx solid #241a2e; transform: rotate(45deg); }

.message-row { display: flex; justify-content: flex-start; margin-top: 18rpx; }
.message-row-user { justify-content: flex-end; }
.message-greeting { margin: 18rpx 24rpx 0; }
.message-bubble {
  position: relative;
  max-width: 86%;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}
.message-assistant { background: #fff; color: #362747; border-bottom-left-radius: 8rpx; }
.message-user { background: #e5d2f6; color: #462b5a; border-bottom-right-radius: 8rpx; }
.message-bubble::after {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  content: "";
}
.message-assistant::after { left: -8rpx; border-right: 12rpx solid #fff; }
.message-user::after { right: -8rpx; border-left: 12rpx solid #e5d2f6; }

.session-bar button,
.session-bar .session {
  box-sizing: border-box;
  height: 56rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 56rpx;
}

.session-bar .session {
  vertical-align: top;
}

.assistant-pet-picker-content {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.assistant-pet-picker-arrow {
  width: 8rpx;
  height: 8rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: translateY(-2rpx) rotate(45deg);
}
