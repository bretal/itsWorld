<view class="launch">
  <image
    wx:if="{{launchBg}}"
    class="launch-bg"
    src="{{launchBg}}"
    mode="aspectFill"
  />

  <view class="launch-bottom">
    <navigator class="start-btn" url="{{startUrl}}" open-type="{{startOpenType}}"
      hover-class="start-btn-pressed" bindtap="onTapStart" bindfail="onStartFail">
      <text>开启宠物之旅</text>
      <text class="arrow">›</text>
    </navigator>
  </view>
</view>
