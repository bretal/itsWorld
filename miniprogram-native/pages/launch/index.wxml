<view class="launch">
  <image
    wx:if="{{launchBg}}"
    class="launch-bg"
    src="{{launchBg}}"
    mode="aspectFill"
  />

  <view class="launch-bottom">
    <button class="start-btn" bindtap="onTapStart">
      <text>开启宠物之旅</text>
      <text class="arrow">›</text>
    </button>
  </view>
</view>
