<view class="login-page">
  <view class="hero">
    <view class="logo-wrap">
      <image
        class="logo"
        src="{{logoUrl || staticAssets['avatar-placeholder.png']}}"
        mode="aspectFit"
      />
    </view>
    <view class="hero-title">{{registering ? '注册账号' : '欢迎回来'}}</view>
    <view class="hero-desc">和TA一起，记录每一个可爱的瞬间</view>
  </view>

  <view class="form-card">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input"
        type="text"
        placeholder="{{registering ? '用户名（至少 3 字符）' : '用户名 / 手机号 / 邮箱'}}"
        placeholder-class="placeholder"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <view class="password-row">
        <input
          class="field-input password-input"
          type="text"
          password="{{!showPassword}}"
          placeholder="请输入密码"
          placeholder-class="placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <text class="toggle" bindtap="togglePassword">
          {{showPassword ? '隐藏' : '显示'}}
        </text>
      </view>
    </view>

    <view class="field" wx:if="{{registering}}">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" />
    </view>
    <view class="field" wx:if="{{registering}}">
      <text class="field-label">确认密码</text>
      <input class="field-input" password="{{true}}" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" placeholder="请再次输入密码" />
    </view>

    <button
      class="btn-primary login-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onSubmit"
    >
      {{registering ? '注册' : '登录'}}
    </button>

     <button class="hint" size="mini" disabled="{{loading}}" bindtap="toggleRegistration">{{registering ? '返回登录' : '注册账号'}}</button>
    <view class="hint" wx:if="{{!registering}}">
      当前版本使用账号密码登录；微信一键登录暂未开放
    </view>
  </view>
</view>
