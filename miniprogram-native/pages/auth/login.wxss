.login-page {
  min-height: 100vh;
  padding: 80rpx 56rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef6ff 0%, #ffffff 46%, #ffffff 100%);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

.logo-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(47, 128, 237, 0.14);
}

.logo {
  width: 168rpx;
  height: 168rpx;
}

.hero-title {
  margin-top: 36rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #1f2329;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.form-card {
  margin-top: 64rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 32rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(31, 35, 41, 0.06);
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.field:last-of-type {
  border-bottom: none;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #8a8f99;
  margin-bottom: 10rpx;
}

.field-input {
  width: 100%;
  height: 64rpx;
  font-size: 32rpx;
  color: #1f2329;
}

.placeholder {
  color: #c5c9cf;
}

.password-row {
  display: flex;
  align-items: center;
}

.password-input {
  flex: 1;
}

.toggle {
  padding-left: 20rpx;
  font-size: 24rpx;
  color: #2f80ed;
}

.login-btn {
  width: 100%;
  margin-top: 36rpx;
}

.hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
  line-height: 1.6;
}
