<view class="profile-page">
  <view class="profile-hero">
    <view class="hero-circle circle-a"></view>
    <view class="hero-circle circle-b"></view>

    <view class="hero-top">
      <view class="hero-title">我的</view>
      <view class="hero-settings" bindtap="showSettings">⚙</view>
    </view>

    <view class="user-row" bindtap="goEditProfile">
      <image
        class="user-avatar"
        src="{{avatarSrc || avatarUrl}}"
        mode="aspectFill"
      />
      <view class="user-info">
        <view class="user-name">{{displayName}}</view>
        <view class="user-tag">🐾 宠物家长</view>
      </view>
      <view class="edit-arrow">›</view>
    </view>
  </view>

  <view class="profile-body">
    <view class="stat-grid">
      <view class="stat-card" data-key="pets" bindtap="onTapMenu">
        <view class="stat-icon pets">🐾</view>
        <view class="stat-info">
          <view class="stat-title">我的宠物</view>
          <view class="stat-value">{{petCount}}<text class="stat-unit">只</text></view>
        </view>
      </view>
      <view class="stat-card" data-key="album" bindtap="onTapMenu">
        <view class="stat-icon album">🖼️</view>
        <view class="stat-info">
          <view class="stat-title">成长相册</view>
          <view class="stat-value">{{photoCount}}<text class="stat-unit">张</text></view>
        </view>
      </view>
    </view>

    <view class="menu-card">
      <view
        wx:for="{{menu}}"
        wx:key="key"
        class="menu-item"
        data-key="{{item.key}}"
        bindtap="onTapMenu"
      >
        <view class="menu-icon">{{item.icon}}</view>
        <view class="menu-text">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>

    <view class="quote-card">
      <view class="quote-text">有你在，</view>
      <view class="quote-text">就是最好的时光</view>
      <view class="quote-emoji">🐶🐱</view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </view>
</view>
