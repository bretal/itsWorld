.profile-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f7f8fa;
}

.profile-hero {
  position: relative;
  padding: 32rpx 32rpx 48rpx;
  background: linear-gradient(150deg, #dbe9ff 0%, #eaf2ff 48%, #f7f8fa 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
}

.circle-a {
  width: 260rpx;
  height: 260rpx;
  top: -100rpx;
  right: -70rpx;
}

.circle-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -60rpx;
  left: -50rpx;
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2329;
}

.hero-settings {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  color: #5a6472;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}

.user-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 35, 41, 0.08);
}

.user-info {
  flex: 1;
  padding-left: 22rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2329;
}

.user-tag {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5a6472;
  font-size: 21rpx;
}

.edit-arrow {
  color: #8a8f99;
  font-size: 40rpx;
}

.profile-body {
  padding: 0 32rpx;
}

.stat-grid {
  display: flex;
  justify-content: space-between;
  margin-top: -24rpx;
}

.stat-card {
  width: 48%;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 35, 41, 0.06);
}

.stat-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.stat-icon.pets {
  background: #eaf2ff;
}

.stat-icon.album {
  background: #f3edff;
}

.stat-info {
  padding-left: 16rpx;
}

.stat-title {
  font-size: 23rpx;
  color: #8a8f99;
}

.stat-value {
  margin-top: 2rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2329;
}

.stat-unit {
  margin-left: 4rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #8a8f99;
}

.menu-card {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f5f8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.menu-text {
  flex: 1;
  padding-left: 18rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}

.menu-desc {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #a3a8b0;
}

.menu-arrow {
  color: #c0c4ca;
  font-size: 36rpx;
}

.quote-card {
  position: relative;
  margin-top: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff6dc 0%, #ffe9b8 100%);
  overflow: hidden;
}

.quote-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #7a5a1e;
  line-height: 1.6;
}

.quote-emoji {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  font-size: 54rpx;
  opacity: 0.9;
}

.logout {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ffffff;
  color: #e05b6f;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(31, 35, 41, 0.04);
}
