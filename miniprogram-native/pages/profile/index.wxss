page{background:#fff6f8;color:#2b2631;}
.profile-page{min-height:100vh;padding-bottom:calc(166rpx + env(safe-area-inset-bottom));background:radial-gradient(ellipse at 100% 15%,#f4e7ff,transparent 55%),radial-gradient(ellipse at 0 50%,#ffeef0,transparent 70%),#fff8f8;}
.profile-hero{position:relative;padding:42rpx 38rpx 32rpx;}
.hero-settings{position:absolute;right:34rpx;top:22rpx;width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;z-index:2;}
.hero-settings .iconfont{font-size:39rpx;color:#887997;}
.user-row{display:flex;align-items:center;min-height:142rpx;}
.user-avatar{width:138rpx;height:138rpx;border:5rpx solid white;border-radius:50%;background:#fff;box-shadow:0 8rpx 22rpx #d4b8d333;flex-shrink:0;}
.user-info{padding-left:22rpx;flex:1;min-width:0;}
.user-name{font-size:38rpx;font-weight:750;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding-right:40rpx;}
.user-tag{display:inline-flex;align-items:center;margin-top:10rpx;padding:3rpx 16rpx 3rpx 8rpx;font-size:22rpx;color:#887299;background:#ffffffbb;border:1rpx solid #fff;border-radius:30rpx;}
.user-tag image{width:34rpx;height:34rpx;margin-right:5rpx;}
.edit-arrow{font-size:40rpx;color:#a293ad;align-self:flex-end;margin-bottom:25rpx;}
.profile-body{padding:0 28rpx;}
.stat-grid{display:flex;gap:16rpx;}
.stat-card{position:relative;display:flex;align-items:center;gap:14rpx;flex:1;min-width:0;height:116rpx;border-radius:28rpx;border:2rpx solid white;padding:15rpx 17rpx;box-shadow:0 7rpx 20rpx #c7a5cf18;overflow:hidden;}
.stat-card.pets{background:linear-gradient(120deg,#fffaf2,#ffece5);}
.stat-card.album{background:linear-gradient(120deg,#fbf6ff,#f0e2ff);}
.stat-icon{width:72rpx;height:72rpx;flex-shrink:0;transform:scale(1.45);}
.album-icon{width:62rpx;height:62rpx;flex-shrink:0;border-radius:18rpx;background:linear-gradient(140deg,#c39aff,#a367ef);box-shadow:0 4rpx 12rpx #ad78dc33;display:flex;align-items:center;justify-content:center;}
.album-icon image{width:70rpx;height:70rpx;transform:scale(1.2);}
.stat-info{flex:1;min-width:0;}
.stat-title{font-size:25rpx;font-weight:650;white-space:nowrap;}
.stat-value{font-size:34rpx;font-weight:700;line-height:1.25;margin-top:3rpx;}
.stat-value text{font-size:21rpx;font-weight:400;color:#9c8caa;margin-left:5rpx;}
.stat-arrow{color:#b39aaa;font-size:30rpx;}
.membership-entry{display:flex;align-items:center;gap:16rpx;padding:16rpx 23rpx;margin-top:18rpx;min-height:108rpx;border:2rpx solid #fff;border-radius:28rpx;background:linear-gradient(110deg,#f6eaff,#ebd9ff 70%,#f3e9ff);box-shadow:0 7rpx 20rpx #bb92d21c;}
.membership-entry>image{width:82rpx;height:76rpx;flex-shrink:0;transform:scale(1.2);}
.membership-copy{flex:1;min-width:0;border-left:1rpx solid #d7b7eb;padding-left:20rpx;}
.membership-copy>view{font-size:30rpx;font-weight:750;}
.membership-copy>text{font-size:21rpx;color:#9476aa;}
.membership-link{border:2rpx solid #d3a7ff;border-radius:32rpx;background:#ffffffbf;color:#9556cb;font-size:22rpx;font-weight:600;padding:10rpx 18rpx;white-space:nowrap;}
.service-card,.menu-card{margin-top:18rpx;background:#ffffffd9;border:2rpx solid white;border-radius:28rpx;box-shadow:0 7rpx 22rpx #b9a1c317;}
.service-card{padding:18rpx 16rpx 22rpx;}
.section-title{font-size:29rpx;font-weight:700;margin-left:8rpx;}
.service-grid{display:flex;margin-top:14rpx;}
.service-item{width:20%;min-width:0;display:flex;flex-direction:column;align-items:center;gap:7rpx;}
.service-item image{width:78rpx;height:72rpx;transform:scale(1.3);}
.service-item text{font-size:23rpx;white-space:nowrap;}
.menu-card{padding:0 22rpx;}
.menu-item{display:flex;align-items:center;min-height:76rpx;border-bottom:1rpx solid #f1e9f7;padding:8rpx 0;}
.menu-item:last-child{border-bottom:0;}
.menu-icon{position:relative;width:56rpx;height:56rpx;flex-shrink:0;margin-right:18rpx;}
.menu-icon image{width:56rpx;height:56rpx;transform:scale(1.3);}
.menu-dot{position:absolute;right:3rpx;top:3rpx;width:10rpx;height:10rpx;border:2rpx solid #fff;border-radius:50%;background:#ff756a;}
.menu-title{flex:1;font-size:27rpx;font-weight:550;}
.menu-arrow{font-size:34rpx;color:#b8aabb;padding-right:5rpx;}
.quote{display:flex;align-items:center;justify-content:center;gap:20rpx;padding:30rpx 0 12rpx;color:#ad90bc;font-size:21rpx;}
.quote view{width:50rpx;height:1rpx;background:#dfc9e8;}
@media(max-width:360px){.stat-card{gap:8rpx;padding:12rpx;}.stat-title{font-size:23rpx;}.membership-link{font-size:21rpx;padding:9rpx 12rpx;}.membership-copy{padding-left:12rpx;}.service-item text{font-size:22rpx;}}