.diary-edit-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.form-card {
  margin-bottom: 22rpx;
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.04);
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f3f5f8;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #5a6472;
}

.form-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #1f2329;
}

.picker-arrow {
  margin-left: 8rpx;
  color: #c0c4ca;
  font-size: 34rpx;
}

.form-block {
  padding: 28rpx 0;
}

.block-label {
  display: block;
  width: auto;
  margin-bottom: 18rpx;
}

.mood-row {
  display: flex;
  justify-content: space-between;
}

.mood-item {
  width: 23%;
  padding: 18rpx 0;
  border-radius: 22rpx;
  background: #f7f9fc;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

.mood-item.active {
  background: #eaf2ff;
  border-color: #2f80ed;
}

.mood-emoji {
  font-size: 40rpx;
}

.mood-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5a6472;
}

.mood-item.active .mood-label {
  color: #2f80ed;
  font-weight: 600;
}

.category-row {
  display: flex;
  align-items: center;
}

.category-item {
  padding: 14rpx 34rpx;
  margin-right: 18rpx;
  border-radius: 30rpx;
  background: #f7f9fc;
  color: #5a6472;
  font-size: 24rpx;
  border: 2rpx solid transparent;
}

.category-item.active {
  background: #eaf2ff;
  color: #2f80ed;
  border-color: #2f80ed;
  font-weight: 600;
}

.content-card {
  padding: 28rpx;
}

.content-input {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.7;
}

.placeholder {
  color: #c5c9cf;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.photo-wrap {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  margin: 0 14rpx 14rpx 0;
}

.photo {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background: #f0f2f5;
}

.photo-remove {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(31, 35, 41, 0.7);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  width: 190rpx;
  height: 190rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #d5dbe4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a3a8b0;
}

.photo-add-icon {
  font-size: 48rpx;
  line-height: 1;
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.switch-card {
  padding: 24rpx 28rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}

.switch-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a3a8b0;
}

.save-btn {
  width: 100%;
  margin-top: 16rpx;
}

.empty-pet {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.empty-btn {
  margin-top: 26rpx;
  padding: 14rpx 42rpx;
  border-radius: 32rpx;
  background: #eaf2ff;
  color: #2f80ed;
  font-size: 25rpx;
  font-weight: 500;
}

.diary-edit-page { padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:linear-gradient(155deg,#fff2e8,#fcebf4 30%,#f2eaff); }
.editor-intro { position:relative; padding:12rpx 12rpx 34rpx; }
.editor-intro>view:first-child { font-size:40rpx; font-weight:700; color:#49304f; }
.editor-intro>text { display:block; margin-top:12rpx; font-size:23rpx; color:#a485a6; }
.intro-paw { position:absolute; right:12rpx; top:0; font-size:54rpx; color:#efb44e; }
.form-card { border:2rpx solid white; border-radius:34rpx; background:#ffffffcc; box-shadow:0 12rpx 30rpx #a97bbb14; margin-bottom:24rpx; }
.card-heading { padding:20rpx 0 4rpx; font-size:30rpx; font-weight:600; color:#593b62; }
.form-item { min-height:90rpx; border-color:#f2e8f4; }
.form-label { color:#7d6685; font-size:26rpx; }
.form-picker { min-width:0; }
.picker-value { color:#513b5d; }
.picker-arrow { color:#b498c4; }
.form-block { padding:24rpx 0; }
.form-block+.form-block { padding-top:4rpx; }
.block-label { font-weight:600; color:#62466e; }
.mood-item { padding:20rpx 0 16rpx; background:#f7f0fa; border-radius:26rpx; border-color:#f2e8f7; }
.mood-item.active { background:linear-gradient(150deg,#fff1dc,#f3deff); border-color:#c69be3; box-shadow:0 6rpx 16rpx #d8b8e533; }
.mood-emoji { font-size:48rpx; line-height:1.4; }
.mood-label { color:#927b9b; }
.mood-item.active .mood-label { color:#8c55ac; }
.category-item { background:#f6eff9; color:#927b9b; padding:12rpx 34rpx; }
.category-item.active { background:#ecdaf9; border-color:#cba5e5; color:#8c55ac; }
.content-input { min-height:180rpx; color:#513b5d; font-size:27rpx; line-height:1.8; }
.placeholder { color:#b7a6c0; }
.word-count { text-align:right; color:#b6a1bf; font-size:21rpx; margin-top:8rpx; }
.photo-heading { display:flex; align-items:center; justify-content:space-between; padding-top:22rpx; margin-top:18rpx; border-top:1rpx solid #f1e6f6; font-size:24rpx; color:#84658f; }
.photo-heading text:last-child { font-size:21rpx; color:#b6a1bf; }
.photo-wrap,.photo-add { width:30%; height:172rpx; margin:0 3% 16rpx 0; }
.photo-add { border-color:#cfb2e1; border-radius:24rpx; background:linear-gradient(145deg,#fff4ed,#f4eafa); color:#ae85bf; }
.photo { border-radius:24rpx; }
.photo-remove { background:#805b96cc; }
.switch-row>view { flex:1; min-width:0; padding-right:12rpx; }
.switch-row switch { flex-shrink:0; }
.switch-title { color:#60476b; font-size:27rpx; }
.switch-desc { color:#ad96b6; line-height:1.6; }
.save-btn { height:96rpx; line-height:92rpx; border-radius:48rpx; border:2rpx solid #fff6db; background:linear-gradient(#ffc35e,#ff981f); color:white; font-size:30rpx; font-weight:600; box-shadow:0 10rpx 24rpx #f3ab6a44; }
.save-btn[disabled] { background:#dec8df; color:white; box-shadow:none; }
.empty-pet { border:2rpx solid white; background:#ffffffbb; color:#60476b; }
.empty-btn { background:#edddf7; color:#9066aa; }
