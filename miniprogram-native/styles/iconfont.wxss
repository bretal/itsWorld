/* Bootstrap Icons subset (MIT): bell, gear, question-circle, star-fill */
@font-face {
  font-family: 'itsworld-icon';
  src: url('data:font/woff2;base64,') format('woff2');
  font-weight: normal;
  font-style: normal;
}

.iconfont {
  font-family: 'itsworld-icon' !important;
  font-style: normal;
  font-weight: normal;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  /* 字体图标只有单一线宽，用描边模拟加粗 */
  -webkit-text-stroke-width: 1rpx;
  -webkit-text-stroke-color: currentColor;
}

.icon-bell:before { content: '\f18a'; }
.icon-star:before { content: '\f586'; }
.icon-help:before { content: '\f505'; }
.icon-settings:before { content: '\f3e5'; }
