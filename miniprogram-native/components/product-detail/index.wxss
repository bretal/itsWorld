.detail-page { min-height:100vh; padding-bottom:calc(145rpx + env(safe-area-inset-bottom)); background:linear-gradient(140deg,#fff3ed,#f8edff 55%,#fffaff); }
.gallery { position:relative; height:490rpx; background:radial-gradient(ellipse at center,#fff9eb,#ffe9ee 65%,#efdcfa); }
.gallery-swiper,.banner { width:100%; height:100%; }
.gallery-placeholder { height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#bc8b66; font-size:24rpx; }
.gallery-placeholder image { width:230rpx; height:230rpx; }
.placeholder-note { margin-top:8rpx; font-size:20rpx; color:#baa3ac; }
.image-count { position:absolute; right:25rpx; bottom:30rpx; background:rgba(78,56,88,.45); color:#fff; padding:2rpx 18rpx; border-radius:25rpx; font-size:23rpx; }
.detail-card { margin:14rpx 16rpx 0; padding:26rpx; border-radius:30rpx; border:2rpx solid #fff; background:rgba(255,255,255,.85); box-shadow:0 8rpx 22rpx rgba(158,115,185,.04); }
.summary { position:relative; margin-top:-10rpx; }
.price-row { display:flex; align-items:center; flex-wrap:wrap; gap:16rpx; }
.price { color:#ff6225; font-size:62rpx; font-weight:750; line-height:1.2; }
.price text { font-size:32rpx; }
.member { border-radius:30rpx; padding:4rpx 18rpx; background:linear-gradient(110deg,#b78240,#854622); color:#fff6dc; font-size:24rpx; }
.name { margin-top:14rpx; font-size:34rpx; font-weight:700; }
.subtitle { font-size:25rpx; color:#8c8197; margin-top:5rpx; }
.product-tags { display:flex; gap:12rpx; margin-top:20rpx; }
.product-tags text { border:2rpx solid #ebdef6; background:#fcf8ff; color:#a07cba; border-radius:25rpx; font-size:21rpx; padding:4rpx 18rpx; }
.selection-row { display:flex; gap:24rpx; }
.field-label { font-size:28rpx; color:#65596e; flex-shrink:0; }
.selection-row > .field-label { padding-top:15rpx; }
.sku-list { flex:1; min-width:0; display:flex; flex-wrap:wrap; gap:14rpx; }
.sku { display:flex; flex-direction:column; align-items:center; min-width:145rpx; padding:8rpx 20rpx; border:2rpx solid #ede3f5; background:#faf6ff; color:#82738f; border-radius:22rpx; font-size:25rpx; }
.sku-price { font-weight:650; }
.sku.active { color:#e87219; border-color:#ff931c; background:linear-gradient(120deg,#fff7e7,#ffe9c9); }
.sku.disabled { opacity:.4; }
.quantity-row { margin-top:24rpx; display:flex; align-items:center; justify-content:space-between; }
.stock { font-size:21rpx; color:#ad9cb8; margin-left:14rpx; }
.stepper { display:flex; align-items:center; gap:20rpx; }
.stepper button { flex:0 0 48rpx; width:48rpx; min-width:0; height:48rpx; padding:0; margin:0; border:2rpx solid #e8e0ef; border-radius:50%; line-height:44rpx; color:#665871; font-size:32rpx; }
.stepper button[disabled] { opacity:.35; }
.stepper > text { min-width:26rpx; text-align:center; }
.member-banner { display:flex; align-items:center; gap:12rpx; margin-top:25rpx; padding:15rpx 12rpx; border-radius:24rpx; background:linear-gradient(120deg,#f1ddff,#f9efff); }
.member-banner image { width:65rpx; height:65rpx; flex-shrink:0; }
.member-title { font-size:26rpx; font-weight:650; color:#9254bc; }
.member-sub { font-size:20rpx; color:#a581b6; }
.member-link { margin-left:auto; font-size:22rpx; white-space:nowrap; color:#b07836; border-radius:24rpx; background:#fff0cc; padding:6rpx 14rpx; }
.detail-tabs { display:flex; gap:46rpx; border-bottom:2rpx solid #f5edf8; margin-bottom:22rpx; color:#9d8ca8; font-size:27rpx; }
.detail-tabs text { padding-bottom:14rpx; }
.selected-tab { color:#3c3044; font-weight:650; border-bottom:5rpx solid #ff882d; }
.desc { display:block; font-size:26rpx; line-height:1.8; color:#716478; overflow:hidden; }
.description-empty { color:#ad9eb7; font-size:24rpx; padding:15rpx 0; }
.spec-info { display:flex; gap:24rpx; padding-top:16rpx; font-size:23rpx; color:#74657d; }
.spec-info text:first-child { color:#b0a0bb; flex-shrink:0; }
.footer { position:fixed; bottom:0; left:0; right:0; z-index:10; display:flex; align-items:center; gap:12rpx; padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); background:rgba(255,252,255,.98); box-shadow:0 -6rpx 24rpx rgba(162,118,185,.07); }
.footer-links { display:flex; flex:0 0 230rpx; justify-content:space-between; }
.footer-icon { display:flex; flex:0 0 70rpx; min-width:0; width:70rpx; margin:0; padding:0; align-items:center; flex-direction:column; font-size:20rpx; color:#8a7b93; }
.footer-icon image { width:49rpx; height:49rpx; transform:scale(1.5); }
.add-cart,.checkout { flex:1; min-width:0; margin:0; padding:0; height:76rpx; line-height:76rpx; border-radius:45rpx; font-size:25rpx; font-weight:650; white-space:nowrap; }
.add-cart { color:#bd701e; background:linear-gradient(110deg,#fff4dc,#ffdfa3); }
.checkout { color:#fff; background:linear-gradient(115deg,#ffbd19,#ff7920); }
.footer button[disabled] { opacity:.45; }
.tip { padding:150rpx 30rpx; text-align:center; font-size:26rpx; color:#a38eaf; }
.in-sheet.detail-page { min-height: 0; padding-bottom: 0; display: flex; flex-direction: column; }
.in-sheet .detail-scroll { height: 58vh; }
.in-sheet .footer { position: static; flex-shrink: 0; }
.tip .retry { display: block; margin: 18rpx auto 0; }
.detail-page button::after { border: 0; }
